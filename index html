  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: Arial, Helvetica, sans-serif;
      background: #05070b;
      color: #ffffff;
      min-height: 100vh;
      line-height: 1.5;
    }

    a {
      color: inherit;
      text-decoration: none;
    }

    button,
    input,
    textarea {
      font: inherit;
    }

    .container {
      width: min(1180px, 92%);
      margin: 0 auto;
    }

    header {
      position: sticky;
      top: 0;
      z-index: 100;
      background: rgba(5, 7, 11, 0.96);
      border-bottom: 1px solid #202733;
      backdrop-filter: blur(12px);
    }

    .header-inner {
      min-height: 76px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 20px;
    }

    .logo {
      font-size: 22px;
      font-weight: 900;
      letter-spacing: 1px;
      color: #ffffff;
    }

    .logo span {
      color: #00e5ff;
    }

    nav {
      display: flex;
      align-items: center;
      gap: 24px;
    }

    nav a {
      color: #b9c1cc;
      font-size: 14px;
      transition: 0.2s;
    }

    nav a:hover {
      color: #00e5ff;
    }

    .hero {
      padding: 90px 0 60px;
      text-align: center;
    }

    .hero-badge {
      display: inline-block;
      padding: 7px 14px;
      border: 1px solid #1f4850;
      border-radius: 999px;
      background: rgba(0, 229, 255, 0.06);
      color: #00e5ff;
      font-size: 12px;
      font-weight: 700;
      letter-spacing: 1px;
      margin-bottom: 22px;
    }

    .hero h1 {
      font-size: clamp(42px, 8vw, 82px);
      line-height: 0.95;
      font-weight: 900;
      letter-spacing: -3px;
      margin-bottom: 24px;
    }

    .hero h1 span {
      color: #00e5ff;
    }

    .hero p {
      max-width: 700px;
      margin: 0 auto 36px;
      color: #9da7b5;
      font-size: 18px;
    }

    .search-box {
      width: min(850px, 100%);
      margin: 0 auto;
      padding: 8px;
      border: 1px solid #29313e;
      border-radius: 18px;
      background: #0c1017;
      box-shadow: 0 0 45px rgba(0, 229, 255, 0.08);
    }

    .search-row {
      display: grid;
      grid-template-columns: 1fr 210px 130px;
      gap: 8px;
    }

    .search-row input {
      width: 100%;
      min-height: 56px;
      padding: 0 18px;
      border: 1px solid #242c38;
      border-radius: 12px;
      outline: none;
      background: #070a0f;
      color: #ffffff;
    }

    .search-row input::placeholder {
      color: #697383;
    }

    .search-row input:focus {
      border-color: #00e5ff;
    }

    .search-button {
      min-height: 56px;
      border: none;
      border-radius: 12px;
      background: #00e5ff;
      color: #001014;
      font-weight: 900;
      cursor: pointer;
      transition: 0.2s;
    }

    .search-button:hover {
      transform: translateY(-1px);
      box-shadow: 0 8px 25px rgba(0, 229, 255, 0.2);
    }

    .search-button:disabled {
      opacity: 0.5;
      cursor: wait;
      transform: none;
    }

    .quick-searches {
      margin-top: 20px;
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 10px;
    }

    .quick-searches button {
      padding: 9px 14px;
      border: 1px solid #29313e;
      border-radius: 999px;
      background: #0c1017;
      color: #c5ccd6;
      cursor: pointer;
    }

    .quick-searches button:hover {
      border-color: #00e5ff;
      color: #00e5ff;
    }

    #resultsSection {
      display: none;
      padding: 45px 0 80px;
    }

    .section-heading {
      margin-bottom: 25px;
    }

    .section-heading h2 {
      font-size: 30px;
      margin-bottom: 6px;
    }

    .section-heading p {
      color: #8994a3;
    }

    .ai-answer {
      margin-bottom: 30px;
      padding: 22px;
      border: 1px solid #24313a;
      border-radius: 16px;
      background: linear-gradient(
        145deg,
        rgba(0, 229, 255, 0.07),
        rgba(12, 16, 23, 0.95)
      );
    }

    .ai-answer-title {
      color: #00e5ff;
      font-weight: 800;
      margin-bottom: 10px;
    }

    .ai-answer-text {
      color: #d7dde5;
      white-space: pre-wrap;
    }

    .results-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 18px;
    }

    .business-card {
      display: flex;
      flex-direction: column;
      min-height: 260px;
      padding: 22px;
      border: 1px solid #242d39;
      border-radius: 16px;
      background: #0b0f15;
      transition: 0.2s;
    }

    .business-card:hover {
      transform: translateY(-3px);
      border-color: #00e5ff;
      box-shadow: 0 12px 35px rgba(0, 229, 255, 0.07);
    }

    .business-category {
      display: inline-block;
      width: fit-content;
      margin-bottom: 12px;
      padding: 5px 9px;
      border-radius: 999px;
      background: rgba(0, 229, 255, 0.08);
      color: #00e5ff;
      font-size: 11px;
      font-weight: 700;
      text-transform: uppercase;
    }

    .business-card h3 {
      font-size: 21px;
      margin-bottom: 10px;
    }

    .business-description {
      color: #a4adba;
      font-size: 14px;
      margin-bottom: 15px;
    }

    .business-details {
      display: grid;
      gap: 7px;
      color: #8d98a7;
      font-size: 13px;
      margin-bottom: 20px;
    }

    .business-actions {
      margin-top: auto;
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
    }

    .business-actions a {
      display: inline-block;
      padding: 8px 11px;
      border: 1px solid #303947;
      border-radius: 8px;
      color: #cbd2dc;
      font-size: 12px;
    }

    .business-actions a:hover {
      border-color: #00e5ff;
      color: #00e5ff;
    }

    .loading {
      padding: 40px 0;
      text-align: center;
      color: #8c97a5;
    }

    .spinner {
      width: 35px;
      height: 35px;
      margin: 0 auto 15px;
      border: 3px solid #26303c;
      border-top-color: #00e5ff;
      border-radius: 50%;
      animation: spin 0.8s linear infinite;
    }

    @keyframes spin {
      to {
        transform: rotate(360deg);
      }
    }

    .error-box {
      padding: 18px;
      border: 1px solid #5b3030;
      border-radius: 12px;
      background: rgba(150, 30, 30, 0.12);
      color: #ffb4b4;
    }

    .directory {
      padding: 80px 0;
      border-top: 1px solid #171d26;
    }

    .directory h2 {
      font-size: 34px;
      margin-bottom: 8px;
    }

    .directory-intro {
      color: #8e99a7;
      margin-bottom: 25px;
    }

    .register {
      padding: 80px 0;
      border-top: 1px solid #171d26;
    }

    .register-box {
      max-width: 760px;
      margin: 0 auto;
      padding: 30px;
      border: 1px solid #27313d;
      border-radius: 18px;
      background: #0b0f15;
    }

    .register-box h2 {
      margin-bottom: 8px;
    }

    .register-box p {
      color: #8994a2;
      margin-bottom: 25px;
    }

    .form-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 12px;
    }

    .form-grid input,
    .form-grid textarea {
      width: 100%;
      padding: 14px;
      border: 1px solid #29313e;
      border-radius: 10px;
      background: #070a0f;
      color: #ffffff;
      outline: none;
    }

    .form-grid textarea {
      min-height: 120px;
      resize: vertical;
      grid-column: 1 / -1;
    }

    .form-grid input:focus,
    .form-grid textarea:focus {
