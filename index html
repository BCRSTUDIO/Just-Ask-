  <script>

    /* ============================================================
       SUPABASE CONFIGURATION
       ============================================================ */

    const SUPABASE_URL =
      "https://mqnzubsfgvdnndfwhpcz.supabase.co";

    /*
     * IMPORTANT:
     * Replace the text below with your EXISTING
     * Supabase PUBLISHABLE key.
     *
     * Do NOT put your secret/service-role key here.
     */

    const SUPABASE_KEY =
      "PASTE_YOUR_EXISTING_SUPABASE_PUBLISHABLE_KEY_HERE";


    /* ============================================================
       JUST-ASK EDGE FUNCTION
       ============================================================ */

    const AI_SEARCH_URL =
      SUPABASE_URL + "/functions/v1/Just-ask";


    /* ============================================================
       PAGE ELEMENTS
       ============================================================ */

    const mainSearch =
      document.getElementById("mainSearch");

    const searchLocation =
      document.getElementById("searchLocation");

    const askButton =
      document.getElementById("askButton");

    const resultsSection =
      document.getElementById("resultsSection");

    const resultsContainer =
      document.getElementById("resultsContainer");

    const aiAnswer =
      document.getElementById("aiAnswer");

    const resultsSummary =
      document.getElementById("resultsSummary");


    /* ============================================================
       SECURITY / HTML ESCAPING
       ============================================================ */

    function escapeHtml(value) {

      if (
        value === null ||
        value === undefined
      ) {
        return "";
      }

      return String(value)
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;")
        .replace(/'/g, "&#039;");
    }


    function safeUrl(value) {

      if (!value) {
        return "";
      }

      try {

        let url =
          String(value).trim();

        if (
          !url.startsWith("http://") &&
          !url.startsWith("https://")
        ) {
          url =
            "https://" + url;
        }

        const parsed =
          new URL(url);

        if (
          parsed.protocol !== "http:" &&
          parsed.protocol !== "https:"
        ) {
          return "";
        }

        return parsed.href;

      } catch (error) {

        return "";

      }

    }


    /* ============================================================
       BUSINESS CARD
       ============================================================ */

    function renderBusinessCard(business) {

      const name =
        business.business_name ||
        business.name ||
        business.displayName?.text ||
        "Business";

      const category =
        business.category ||
        business.primaryType ||
        business.primaryTypeDisplayName?.text ||
        "Local Business";

      const description =
        business.description ||
        "";

      const address =
        business.address ||
        business.formattedAddress ||
        "";

      const phone =
        business.phone ||
        business.nationalPhoneNumber ||
        business.internationalPhoneNumber ||
        "";

      const website =
        business.website ||
        business.websiteUri ||
        "";

      const websiteUrl =
        safeUrl(website);

      const googleMapsUrl =
        business.googleMapsUri ||
        "";

      const phoneUrl =
        phone
          ? "tel:" +
            String(phone).replace(/[^\d+]/g, "")
          : "";


      return `
        <article class="business-card">

          <div class="business-category">
            ${escapeHtml(category)}
          </div>

          <h3>
            ${escapeHtml(name)}
          </h3>

          ${
            description
              ? `
                <div class="business-description">
                  ${escapeHtml(description)}
                </div>
              `
              : ""
          }

          <div class="business-details">

            ${
              address
                ? `
                  <div>
                    ${escapeHtml(address)}
                  </div>
                `
                : ""
            }

            ${
              phone
                ? `
                  <div>
                    ${escapeHtml(phone)}
                  </div>
                `
                : ""
            }

          </div>

          <div class="business-actions">

            ${
              phoneUrl
                ? `
                  <a href="${escapeHtml(phoneUrl)}">
                    Call
                  </a>
                `
                : ""
            }

            ${
              websiteUrl
                ? `
                  <a
                    href="${escapeHtml(websiteUrl)}"
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    Website
                  </a>
                `
                : ""
            }

            ${
              googleMapsUrl
                ? `
                  <a
                    href="${escapeHtml(googleMapsUrl)}"
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    Directions
                  </a>
                `
                : ""
            }

          </div>

        </article>
      `;
    }


    /* ============================================================
       AI SEARCH
       ============================================================ */

    async function performSearch(
      queryOverride = null
    ) {

      const query =
        queryOverride ||
        mainSearch.value.trim();

      const location =
        searchLocation.value.trim();


      if (!query) {

        mainSearch.focus();

        return;

      }


      resultsSection.style.display =
        "block";

      resultsContainer.innerHTML = `
        <div class="loading">

          <div class="spinner"></div>

          Searching local businesses...

        </div>
      `;

      aiAnswer.innerHTML = "";

      resultsSummary.textContent =
        "Searching...";

      askButton.disabled = true;

      askButton.textContent =
        "SEARCHING";


      try {

        const response =
          await fetch(
            AI_SEARCH_URL,
            {
              method: "POST",

              headers: {
                "Content-Type":
                  "application/json",

                "apikey":
                  SUPABASE_KEY,

                "Authorization":
                  "Bearer " + SUPABASE_KEY
              },

              body:
                JSON.stringify({
                  query: query,
                  location: location
                })
            }
          );


        let data = null;

        try {

          data =
            await response.json();

        } catch (jsonError) {

          throw new Error(
            "The search server returned an invalid response."
          );

        }


        if (!response.ok) {

          const message =
            data?.message ||
            data?.error ||
            `Search failed (${response.status})`;

          throw new Error(message);

        }


        const businesses =
          Array.isArray(data.results)
            ? data.results
            : Array.isArray(data.businesses)
              ? data.businesses
              : [];


        const answer =
          data.answer || "";


        if (answer) {

          aiAnswer.innerHTML = `
            <div class="ai-answer">

              <div class="ai-answer-title">
                AI SEARCH
              </div>

              <div class="ai-answer-text">
                ${escapeHtml(answer)}
              </div>

            </div>
          `;

        }


        resultsSummary.textContent =
          businesses.length === 1
            ? "1 business found."
            : `${businesses.length} businesses found.`;


        if (!businesses.length) {

          resultsContainer.innerHTML = `
            <div class="error-box">

              No matching businesses were found.

              <br><br>

              Try a different search or location.

            </div>
          `;

          return;

        }


        resultsContainer.innerHTML = `
          <div class="results-grid">

            ${businesses
              .map(renderBusinessCard)
              .join("")}

          </div>
        `;


        resultsSection.scrollIntoView({
          behavior: "smooth",
          block: "start"
        });


      } catch (error) {

        console.error(
          "JUST ASK SEARCH ERROR:",
          error
        );


        resultsSummary.textContent =
          "Search error";


        resultsContainer.innerHTML = `
          <div class="error-box">

            <strong>
              Search could not be completed.
            </strong>

            <br><br>

            ${escapeHtml(error.message)}

          </div>
        `;


      } finally {

        askButton.disabled =
          false;

        askButton.textContent =
          "ASK";

      }

    }


    /* ============================================================
       ASK BUTTON
       ============================================================ */

    askButton.addEventListener(
      "click",
      () => performSearch()
    );


    /* ============================================================
       ENTER KEY
       ============================================================ */

    mainSearch.addEventListener(
      "keydown",
      function(event) {

        if (event.key === "Enter") {

          event.preventDefault();

          performSearch();

        }

      }
    );


    /* ============================================================
       QUICK SEARCH BUTTONS
       ============================================================ */

    document
      .querySelectorAll("[data-query]")
      .forEach(button => {

        button.addEventListener(
          "click",
          () => {

            const query =
              button.dataset.query;

            mainSearch.value =
              query;

            performSearch(query);

          }
        );

      });


    /* ============================================================
       LOAD APPROVED DIRECTORY
       ============================================================ */

    async function loadDirectory() {

      const directoryResults =
        document.getElementById(
          "directoryResults"
        );


      try {

        const url =
          SUPABASE_URL +
          "/rest/v1/businesses" +
          "?status=eq.approved" +
          "&order=business_name.asc";


        const response =
          await fetch(
            url,
            {
              method: "GET",

              headers: {
                "apikey":
                  SUPABASE_KEY,

                "Authorization":
                  "Bearer " + SUPABASE_KEY,

                "Content-Type":
                  "application/json"
              }
            }
          );


        if (!response.ok) {

          throw new Error(
            `Directory request failed (${response.status})`
          );

        }


        const businesses =
          await response.json();


        if (
          !Array.isArray(businesses) ||
          businesses.length === 0
        ) {

          directoryResults.innerHTML = `
            <div class="error-box">
              No approved businesses are currently listed.
            </div>
          `;

          return;

        }


        directoryResults.innerHTML = `
          <div class="results-grid">

            ${businesses
              .map(renderBusinessCard)
              .join("")}

          </div>
        `;


      } catch (error) {

        console.error(
          "DIRECTORY ERROR:",
          error
        );


        directoryResults.innerHTML = `
          <div class="error-box">

            Unable to load the business directory.

            <br><br>

            ${escapeHtml(error.message)}

          </div>
        `;

      }

    }


    /* ============================================================
       BUSINESS REGISTRATION
       ============================================================ */

    const businessForm =
      document.getElementById(
        "businessForm"
      );


    businessForm.addEventListener(
      "submit",
      async function(event) {

        event.preventDefault();


        const message =
          document.getElementById(
            "registerMessage"
          );


        message.textContent =
          "Submitting business...";


        const business = {

          business_name:
            document
              .getElementById("businessName")
              .value
              .trim(),

          category:
            document
              .getElementById("businessCategory")
              .value
              .trim(),

          description:
            document
              .getElementById("businessDescription")
              .value
              .trim(),

          address:
            document
              .getElementById("businessAddress")
              .value
              .trim(),

          area:
            document
              .getElementById("businessArea")
              .value
              .trim(),

          postcode:
            document
              .getElementById("businessPostcode")
              .value
              .trim(),

          phone:
            document
              .getElementById("businessPhone")
              .value
              .trim(),

          email:
            document
              .getElementById("businessEmail")
              .value
              .trim(),

          website:
            document
              .getElementById("businessWebsite")
              .value
              .trim(),

          status:
            "pending"

        };


        try {

          const response =
            await fetch(
              SUPABASE_URL +
              "/rest/v1/businesses",
              {
                method: "POST",

                headers: {

                  "apikey":
                    SUPABASE_KEY,

                  "Authorization":
                    "Bearer " + SUPABASE_KEY,

                  "Content-Type":
                    "application/json",

                  "Prefer":
                    "return=minimal"

                },

                body:
                  JSON.stringify(business)

              }
            );


          if (!response.ok) {

            const errorText =
              await response.text();

            throw new Error(
              errorText ||
              `Submission failed (${response.status})`
            );

          }


          message.textContent =
            "Thank you. Your business has been submitted for approval.";


          businessForm.reset();


        } catch (error) {

          console.error(
            "BUSINESS SUBMISSION ERROR:",
            error
          );


          message.textContent =
            "Unable to submit the business: " +
            error.message;

        }

      }
    );


    /* ============================================================
       START DIRECTORY
       ============================================================ */

    loadDirectory();

  </script>

</body>
</html>
