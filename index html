  <main>

```
<section class="hero" id="search">
  <div class="container">

    <div class="eyebrow">
      <span class="eyebrow-dot"></span>
      BCR Local AI Search
    </div>

    <h1>
      <span class="gradient-text">Just Ask.</span><br />
      Find What You Need.
    </h1>

    <p>
      Ask naturally and discover local businesses, services and places
      across the BCR directory.
    </p>

    <div class="search-shell">

      <form id="searchForm">

        <div class="search-row">

          <div class="input-wrap">
            <input
              id="searchQuery"
              type="text"
              autocomplete="off"
              placeholder="Try: best barber for a skin fade"
              required
            />
          </div>

          <div class="input-wrap">
            <input
              id="searchLocation"
              type="text"
              autocomplete="off"
              placeholder="Location"
            />
          </div>

          <button
            id="searchButton"
            class="search-button"
            type="submit"
          >
            Ask AI
          </button>

        </div>

      </form>

      <div class="search-hint">
        Try asking for a service, business type, product or local recommendation.
      </div>

    </div>

  </div>
</section>


<section class="section" id="results">

  <div class="container">

    <div class="section-header">
      <h2>AI Results</h2>
      <p>Relevant businesses from the BCR directory and connected local search sources.</p>
    </div>

    <div id="searchStatus" class="status-box"></div>

    <div id="aiAnswer" class="ai-answer">
      <div class="ai-answer-label">AI Summary</div>
      <div id="aiAnswerText" class="ai-answer-text"></div>
    </div>

    <div id="resultsGrid" class="results-grid">

      <div class="empty-state">
        <strong>Ask something to get started</strong>
        Search for a local business or service above.
      </div>

    </div>

  </div>

</section>


<section class="section" id="directory">

  <div class="container">

    <div class="section-header">
      <h2>Local Directory</h2>
      <p>Browse approved businesses currently listed in the BCR directory.</p>
    </div>

    <div class="directory-toolbar">

      <input
        id="directorySearch"
        class="directory-search"
        type="search"
        placeholder="Filter businesses..."
        autocomplete="off"
      />

      <button
        id="directoryRefresh"
        class="small-button"
        type="button"
      >
        Refresh Directory
      </button>

    </div>

    <div id="directoryGrid" class="results-grid">

      <div class="empty-state">
        <strong>Loading directory...</strong>
        Please wait.
      </div>

    </div>

  </div>

</section>


<section class="section register-section" id="register">

  <div class="container">

    <div class="register-grid">

      <div class="register-copy">

        <div class="eyebrow">
          <span class="eyebrow-dot"></span>
          For Local Businesses
        </div>

        <h2>Put your business in front of people who are asking.</h2>

        <p>
          Add your business to the JUST ASK BCR AI directory so customers
          can discover you when they search for relevant services.
        </p>

        <div class="register-points">
          <div class="register-point">
            Appear in local AI-powered searches.
          </div>

          <div class="register-point">
            Showcase your business information and services.
          </div>

          <div class="register-point">
            Build your presence in the BCR business directory.
          </div>
        </div>

      </div>


      <div class="form-card">

        <form id="businessForm">

          <div class="form-grid">

            <div class="field">
              <label for="businessName">Business name *</label>
              <input
                id="businessName"
                name="business_name"
                type="text"
                required
                placeholder="Your business"
              />
            </div>

            <div class="field">
              <label for="category">Category *</label>
              <input
                id="category"
                name="category"
                type="text"
                required
                placeholder="e.g. Barber"
              />
            </div>

            <div class="field full">
              <label for="description">Description</label>
              <textarea
                id="description"
                name="description"
                placeholder="Tell customers what your business does..."
              ></textarea>
            </div>

            <div class="field">
              <label for="address">Address</label>
              <input
                id="address"
                name="address"
                type="text"
                placeholder="Street address"
              />
            </div>

            <div class="field">
              <label for="area">Area</label>
              <input
                id="area"
                name="area"
                type="text"
                placeholder="Area / town"
              />
            </div>

            <div class="field">
              <label for="postcode">Postcode</label>
              <input
                id="postcode"
                name="postcode"
                type="text"
                placeholder="Postcode"
              />
            </div>

            <div class="field">
              <label for="phone">Phone</label>
              <input
                id="phone"
                name="phone"
                type="tel"
                placeholder="Phone number"
              />
            </div>

            <div class="field">
              <label for="email">Email</label>
              <input
                id="email"
                name="email"
                type="email"
                placeholder="Business email"
              />
            </div>

            <div class="field">
              <label for="website">Website</label>
              <input
                id="website"
                name="website"
                type="url"
                placeholder="https://..."
              />
            </div>

            <div class="field full">
              <label for="openingHours">Opening hours</label>
              <input
                id="openingHours"
                name="opening_hours"
                type="text"
                placeholder="e.g. Mon-Fri 9am-6pm"
              />
            </div>

          </div>

          <button
            id="businessSubmit"
            class="submit-button"
            type="submit"
          >
            Submit Business
          </button>

          <div
            id="businessMessage"
            class="form-message"
          ></div>

        </form>

      </div>

    </div>

  </div>

</section>
```

  </main>

