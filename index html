<!DOCTYPE html>

<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>JUST ASK BCR AI</title>

<style>
:root {
  --bg: #050914;
  --bg2: #091222;
  --panel: rgba(15, 25, 43, 0.78);
  --line: rgba(110, 190, 255, 0.18);
  --blue: #38a8ff;
  --cyan: #5ee7ff;
  --white: #f7fbff;
  --muted: #91a3bb;
  --green: #38e6a2;
  --gold: #ffd166;
  --danger: #ff6b7a;
  --radius: 24px;
  --shadow: 0 25px 70px rgba(0,0,0,.45);
}

* {
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
}

body {
  margin: 0;
  font-family: Inter, ui-sans-serif, system-ui, -apple-system,
    BlinkMacSystemFont, "Segoe UI", sans-serif;
  color: var(--white);
  background:
    radial-gradient(circle at 10% 10%, rgba(56,168,255,.16), transparent 28%),
    radial-gradient(circle at 90% 20%, rgba(94,231,255,.10), transparent 25%),
    radial-gradient(circle at 50% 100%, rgba(41,90,180,.12), transparent 35%),
    var(--bg);
  min-height: 100vh;
}

body::before {
  content: "";
  position: fixed;
  inset: 0;
  pointer-events: none;
  background-image:
    linear-gradient(rgba(255,255,255,.018) 1px, transparent 1px),
    linear-gradient(90deg, rgba(255,255,255,.018) 1px, transparent 1px);
  background-size: 50px 50px;
  mask-image: linear-gradient(to bottom, black, transparent 80%);
}

header {
  position: sticky;
  top: 0;
  z-index: 100;
  backdrop-filter: blur(20px);
  background: rgba(5,9,20,.72);
  border-bottom: 1px solid rgba(255,255,255,.07);
}

.nav {
  width: min(1250px, calc(100% - 32px));
  margin: auto;
  min-height: 76px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
}

.logo {
  display: flex;
  align-items: center;
  gap: 12px;
  font-weight: 900;
  letter-spacing: -.04em;
  font-size: 20px;
}

.logo-mark {
  width: 42px;
  height: 42px;
  border-radius: 13px;
  display: grid;
  place-items: center;
  background: linear-gradient(145deg, #43b7ff, #2164ff);
  box-shadow:
    inset 0 1px 1px rgba(255,255,255,.5),
    0 10px 30px rgba(33,100,255,.35);
}

.logo-mark span {
  font-size: 20px;
  font-weight: 1000;
}

.nav-links {
  display: flex;
  gap: 8px;
}

.nav-links button {
  border: 0;
  background: transparent;
  color: var(--muted);
  padding: 10px 14px;
  border-radius: 12px;
  cursor: pointer;
  font-weight: 700;
}

.nav-links button:hover {
  color: white;
  background: rgba(255,255,255,.06);
}

.hero {
  width: min(1250px, calc(100% - 32px));
  margin: auto;
  padding: 90px 0 50px;
  text-align: center;
  position: relative;
}

.hero-badge {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 8px 14px;
  border: 1px solid rgba(94,231,255,.22);
  border-radius: 999px;
  background: rgba(94,231,255,.06);
  color: #aeefff;
  font-size: 13px;
  font-weight: 800;
}

.status-dot {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: var(--green);
  box-shadow: 0 0 14px var(--green);
}

h1 {
  margin: 24px auto 14px;
  max-width: 950px;
  font-size: clamp(48px, 8vw, 94px);
  line-height: .91;
  letter-spacing: -.065em;
  font-weight: 950;
}

.gradient-text {
  background: linear-gradient(90deg, #fff, #76d9ff, #4da0ff, #fff);
  background-size: 250% auto;
  -webkit-background-clip: text;
  color: transparent;
  animation: shine 7s linear infinite;
}

@keyframes shine {
  to {
    background-position: 250% center;
  }
}

.hero p {
  color: var(--muted);
  font-size: 18px;
  max-width: 680px;
  margin: 0 auto 32px;
  line-height: 1.7;
}

.search-shell {
  max-width: 920px;
  margin: 35px auto 0;
  padding: 10px;
  border-radius: 30px;
  background: linear-gradient(
    145deg,
    rgba(94,231,255,.18),
    rgba(255,255,255,.035)
  );
  border: 1px solid rgba(94,231,255,.15);
  box-shadow:
    0 30px 90px rgba(0,0,0,.45),
    inset 0 1px rgba(255,255,255,.1);
}

.search-box {
  display: grid;
  grid-template-columns: 1fr 190px 145px;
  gap: 10px;
  padding: 7px;
  border-radius: 22px;
  background: rgba(4,9,18,.88);
}

.search-box input,
.search-box select {
  min-width: 0;
  height: 58px;
  border: 1px solid rgba(255,255,255,.07);
  border-radius: 17px;
  background: rgba(255,255,255,.045);
  color: white;
  outline: none;
  padding: 0 18px;
  font-size: 15px;
}

.search-box input::placeholder {
  color: #71839c;
}

.search-box input:focus,
.search-box select:focus {
  border-color: rgba(94,231,255,.55);
  box-shadow: 0 0 0 3px rgba(94,231,255,.08);
}

.search-box select option {
  background: #101a2c;
}

.ask-button {
  height: 58px;
  border: 0;
  border-radius: 17px;
  cursor: pointer;
  color: white;
  font-size: 16px;
  font-weight: 900;
  background: linear-gradient(145deg, #4bc8ff, #2865ff);
  box-shadow:
    inset 0 1px rgba(255,255,255,.45),
    0 12px 30px rgba(38,108,255,.3);
  transition: .2s;
}

.ask-button:hover {
  transform: translateY(-2px);
}

.ask-button:disabled {
  opacity: .65;
  cursor: wait;
  transform: none;
}

.section {
  width: min(1250px, calc(100% - 32px));
  margin: auto;
  padding: 50px 0;
}

.section-heading {
  margin-bottom: 25px;
}

.section-heading h2 {
  margin: 0;
  font-size: clamp(28px, 4vw, 44px);
  letter-spacing: -.045em;
}

.section-heading p {
  color: var(--muted);
  margin: 8px 0 0;
}

.quick-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 18px;
  perspective: 1400px;
}

.quick-card {
  min-height: 190px;
  position: relative;
  overflow: hidden;
  border-radius: 25px;
  border: 1px solid rgba(120,200,255,.16);
  background:
    linear-gradient(145deg, rgba(32,51,81,.82), rgba(10,18,32,.86));
  box-shadow:
    0 22px 45px rgba(0,0,0,.38),
    inset 0 1px rgba(255,255,255,.09);
  cursor: pointer;
  transform-style: preserve-3d;
  transition: .3s ease;
  text-align: left;
  padding: 24px;
  color: white;
}

.quick-card:hover {
  transform: translateY(-9px) rotateX(3deg) rotateY(-2deg);
  border-color: rgba(94,231,255,.45);
}

.card-icon {
  width: 58px;
  height: 58px;
  display: grid;
  place-items: center;
  border-radius: 18px;
  font-size: 28px;
  background: linear-gradient(
    145deg,
    rgba(92,210,255,.22),
    rgba(48,98,255,.13)
  );
  border: 1px solid rgba(120,220,255,.18);
  box-shadow:
    inset 0 1px rgba(255,255,255,.13),
    0 12px 25px rgba(0,0,0,.25);
}

.quick-card h3 {
  margin: 20px 0 5px;
  font-size: 20px;
}

.quick-card p {
  margin: 0;
  color: var(--muted);
  font-size: 13px;
  line-height: 1.5;
}

.card-arrow {
  position: absolute;
  right: 20px;
  bottom: 20px;
  font-size: 20px;
  color: #8deaff;
}

.special-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20px;
  margin-top: 20px;
}

.special-card {
  min-height: 180px;
  padding: 28px;
  border-radius: 26px;
  border: 1px solid rgba(255,255,255,.09);
  background:
    linear-gradient(145deg, rgba(22,35,59,.9), rgba(7,14,26,.9));
  box-shadow: var(--shadow);
  cursor: pointer;
  transition: .3s;
  position: relative;
  overflow: hidden;
}

.special-card:hover {
  transform: translateY(-7px);
  border-color: rgba(94,231,255,.3);
}

.special-card h3 {
  font-size: 25px;
  margin: 0 0 8px;
}

.special-card p {
  color: var(--muted);
  line-height: 1.6;
  margin: 0;
}

.special-card .big-symbol {
  position: absolute;
  right: 25px;
  bottom: -20px;
  font-size: 110px;
  opacity: .08;
}

#resultsSection {
  display: none;
}

.results-toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 15px;
  margin-bottom: 20px;
}

.results-count {
  color: var(--muted);
}

.clear-button {
  border: 1px solid rgba(255,255,255,.1);
  background: rgba(255,255,255,.04);
  color: white;
  border-radius: 12px;
  padding: 10px 15px;
  cursor: pointer;
}

.results-grid,
.directory-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 18px;
}

.business-card {
  border: 1px solid rgba(255,255,255,.09);
  border-radius: 23px;
  background:
    linear-gradient(145deg, rgba(20,32,52,.9), rgba(8,15,27,.93));
  padding: 23px;
  box-shadow: 0 20px 50px rgba(0,0,0,.35);
  transition: .25s;
  position: relative;
}

.business-card:hover {
  transform: translateY(-6px);
  border-color: rgba(94,231,255,.3);
}

.business-name {
  font-size: 19px;
  font-weight: 900;
  line-height: 1.25;
}

.badges {
  display: flex;
  flex-wrap: wrap;
  gap: 5px;
  margin-top: 10px;
}

.badge {
  display: inline-flex;
  padding: 5px 8px;
  border-radius: 999px;
  font-size: 10px;
  font-weight: 900;
  letter-spacing: .03em;
}

.badge-bcr {
  background: rgba(56,230,162,.12);
  color: #63efb6;
  border: 1px solid rgba(56,230,162,.2);
}

.badge-google {
  background: rgba(94,231,255,.12);
  color: #8deaff;
  border: 1px solid rgba(94,231,255,.2);
}

.business-category {
  color: #77cfff;
  margin-top: 14px;
  font-size: 13px;
  font-weight: 800;
}

.business-detail {
  color: var(--muted);
  font-size: 13px;
  margin-top: 9px;
  line-height: 1.5;
}

.business-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  margin-top: 18px;
}

.business-actions a {
  text-decoration: none;
  border: 1px solid rgba(255,255,255,.09);
  background: rgba(255,255,255,.045);
  color: white;
  border-radius: 11px;
  padding: 9px 11px;
  font-size: 12px;
  font-weight: 800;
}

.business-actions a:hover {
  background: rgba(94,231,255,.1);
  border-color: rgba(94,231,255,.25);
}

.form-panel {
  max-width: 850px;
  margin: auto;
  padding: 30px;
  border-radius: 28px;
  border: 1px solid rgba(255,255,255,.09);
  background: rgba(13,23,40,.82);
  box-shadow: var(--shadow);
}

.form-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14px;
}

.form-field {
  display: flex;
  flex-direction: column;
  gap: 7px;
}

.form-field.full {
  grid-column: 1 / -1;
}

.form-field label {
  color: #aabbd0;
  font-size: 12px;
  font-weight: 800;
}

.form-field input,
.form-field textarea {
  width: 100%;
  border: 1px solid rgba(255,255,255,.08);
  border-radius: 13px;
  background: rgba(255,255,255,.04);
  color: white;
  padding: 13px;
  outline: none;
  font: inherit;
}

.form-field textarea {
  min-height: 110px;
  resize: vertical;
}

.form-field input:focus,
.form-field textarea:focus {
  border-color: rgba(94,231,255,.4);
}

.submit-button {
  margin-top: 18px;
  border: 0;
  border-radius: 14px;
  padding: 14px 20px;
  background: linear-gradient(145deg, #45caff, #2766ff);
  color: white;
  font-weight: 900;
  cursor: pointer;
}

.submit-button:disabled {
  opacity: .65;
  cursor: wait;
}

.notice {
  padding: 16px 18px;
  border-radius: 15px;
  background: rgba(255,255,255,.045);
  border: 1px solid rgba(255,255,255,.07);
  color: var(--muted);
  line-height: 1.5;
  margin-top: 15px;
}

.notice.success {
  border-color: rgba(56,230,162,.25);
}

.notice.error {
  border-color: rgba(255,107,122,.25);
  color: #ffb8c0;
}

.loading {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 25px;
  justify-content: center;
  color: var(--muted);
}

.spinner {
  width: 23px;
  height: 23px;
  border: 3px solid rgba(255,255,255,.1);
  border-top-color: var(--cyan);
  border-radius: 50%;
  animation: spin .7s linear infinite;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

footer {
  margin-top: 80px;
  border-top: 1px solid rgba(255,255,255,.07);
  padding: 35px 16px;
  text-align: center;
  color: #687a92;
  font-size: 13px;
}

@media (max-width: 950px) {
  .quick-grid {
    grid-template-columns: repeat(2, 1fr);
  }

  .results-grid,
  .directory-grid {
    grid-template-columns: repeat(2, 1fr);
  }

  .search-box {
    grid-template-columns: 1fr 1fr;
  }

  .search-box input {
    grid-column: 1 / -1;
  }
}

@media (max-width: 650px) {
  .nav-links {
    display: none;
  }

  .hero {
    padding-top: 60px;
  }

  h1 {
    font-size: 48px;
  }

  .search-box,
  .quick-grid,
  .results-grid,
  .directory-grid,
  .special-grid,
  .form-grid {
    grid-template-columns: 1fr;
  }

  .search-box input {
    grid-column: auto;
  }

  .form-field.full {
    grid-column: auto;
  }

  .quick-card {
    min-height: 160px;
  }

  .section {
    padding: 35px 0;
  }
}
</style>

</head>

