<footer>
  JUST ASK BCR AI · Local business search
</footer>

<script>

/* =========================================================
   SUPABASE CONFIGURATION
========================================================= */

const SUPABASE_URL =
  "https://mqnzubsfgvdnndfwhpcz.supabase.co";

const SUPABASE_KEY =
  "sb_publishable_oEf2PGkToQHsw_Tvo-faAA_L9uS1aX6";

/*
  IMPORTANT:
  This MUST be bcr-search.
  The old smooth-endpoint function is no longer used.
*/

const AI_SEARCH_URL =
  SUPABASE_URL +
  "/functions/v1/bcr-search";


/* =========================================================
   HELPERS
========================================================= */

function escapeHtml(value) {

  if (value === null || value === undefined) {
    return "";
  }

  return String(value)
    .replace(/&/g, "&amp;")
    .replace(/</g, "&lt;")
    .replace(/>/g, "&gt;")
    .replace(/"/g, "&quot;")
    .replace(/'/g, "&#039;");
}


function scrollToSection(id) {

  const element =
    document.getElementById(id);

  if (element) {

    element.scrollIntoView({
      behavior: "smooth",
      block: "start"
    });

  }

}


/* =========================================================
   SEARCH
========================================================= */

async function performSearch(customQuery = null) {

  const searchInput =
    document.getElementById("mainSearch");

  const locationInput =
    document.getElementById("searchLocation");

  const resultsSection =
    document.getElementById("resultsSection");

  const resultsContainer =
    document.getElementById("askResults");

  const resultsCount =
    document.getElementById("resultsCount");

  const button =
    document.getElementById("askButton");


  const query =
    customQuery ||
    searchInput.value.trim();


  const location =
    locationInput.value || "anywhere";


  if (!query) {

    searchInput.focus();

    return;

  }


  searchInput.value = query;

  resultsSection.style.display = "block";

  resultsContainer.innerHTML = `
    <div class="loading">
      <div class="spinner"></div>
      BCR AI is searching...
    </div>
  `;

  resultsCount.textContent = "";

  button.disabled = true;
  button.textContent = "SEARCHING...";


  resultsSection.scrollIntoView({
    behavior: "smooth",
    block: "start"
  });


  try {

    const response =
      await fetch(
        AI_SEARCH_URL,
        {
          method: "POST",

          headers: {
            "Content-Type": "application/json",
            "Accept": "application/json",
            "apikey": SUPABASE_KEY
          },

          body: JSON.stringify({
            query: query,
            location: location
          })
        }
      );


    const responseText =
      await response.text();


    let data = null;


    try {

      data =
        responseText
          ? JSON.parse(responseText)
          : null;

    } catch (parseError) {

      console.error(
        "Invalid JSON from search function:",
        responseText
      );

      throw new Error(
        "The BCR search service returned an invalid response."
      );

    }


    if (!response.ok) {

      throw new Error(
        (data && (
          data.message ||
          data.error
        )) ||
        `Search failed (${response.status})`
      );

    }


    const businesses =
      data && Array.isArray(data.results)
        ? data.results
        : [];


    resultsCount.textContent =
      `${businesses.length} result${
        businesses.length === 1 ? "" : "s"
      } found`;


    if (!businesses.length) {

      const bcrCount =
        data &&
        data.sources &&
        Number.isFinite(
          Number(data.sources.bcr)
        )
          ? Number(data.sources.bcr)
          : 0;


      const googleCount =
        data &&
        data.sources &&
        Number.isFinite(
          Number(data.sources.google)
        )
          ? Number(data.sources.google)
          : 0;


      resultsContainer.innerHTML = `

        <div class="notice">

          <strong>No matching businesses found.</strong>

          <br><br>

          Try another search, category or location.

          <br><br>

          BCR businesses searched:
          ${bcrCount}

          <br>

          Google businesses returned:
          ${googleCount}

        </div>

      `;

      return;

    }


    renderBusinesses(
      businesses,
      resultsContainer
    );


  } catch (error) {

    console.error(
      "Search error:",
      error
    );


    resultsContainer.innerHTML = `

      <div class="notice error">

        <strong>Search could not be completed.</strong>

        <br><br>

        ${escapeHtml(
          error && error.message
            ? error.message
            : "Unknown search error."
        )}

      </div>

    `;

  } finally {

    button.disabled = false;
    button.textContent = "ASK AI →";

  }

}


/* =========================================================
   BUSINESS CARD
========================================================= */

function renderBusinesses(
  businesses,
  container
) {

  container.innerHTML = `

    <div class="results-grid">

      ${businesses
        .map(
          business =>
            renderBusinessCard(business)
        )
        .join("")}

    </div>

  `;

}


function renderBusinessCard(business) {

  const name =
    business.business_name ||
    business.name ||
    "Business";


  const category =
    business.category ||
    "";


  const address =
    business.address ||
    "";


  const phone =
    business.phone ||
    "";


  const email =
    business.email ||
    "";


  const website =
    business.website ||
    "";


  const maps =
    business.google_maps_url ||
    business.maps_url ||
    "";


  const description =
    business.description ||
    "";


  const partner =
    Boolean(
      business.partner ||
      business.bcr_registered
    );


  const source =
    business.source ||
    "";


  return `

    <article class="business-card">

      <div class="business-name">
        ${escapeHtml(name)}
      </div>


      <div class="badges">

        ${
          partner
            ? `
              <span class="badge badge-bcr">
                BCR REGISTERED
              </span>
            `
            : ""
        }


        ${
          source === "google"
            ? `
              <span class="badge badge-google">
                GOOGLE
              </span>
            `
            : ""
        }

      </div>


      ${
        category
          ? `
            <div class="business-category">
              ${escapeHtml(category)}
            </div>
          `
          : ""
      }


      ${
        description
          ? `
            <div class="business-detail">
              ${escapeHtml(description)}
            </div>
          `
          : ""
      }


      ${
        address
          ? `
            <div class="business-detail">
              📍 ${escapeHtml(address)}
            </div>
          `
          : ""
      }


      ${
        phone
          ? `
            <div class="business-detail">
              ☎ ${escapeHtml(phone)}
            </div>
          `
          : ""
      }


      ${
        email
          ? `
            <div class="business-detail">
              ✉ ${escapeHtml(email)}
            </div>
          `
          : ""
      }


      <div class="business-actions">

        ${
          phone
            ? `
              <a href="tel:${escapeHtml(phone)}">
                CALL
              </a>
            `
            : ""
        }


        ${
          website
            ? `
              <a
                href="${escapeHtml(website)}"
                target="_blank"
                rel="noopener noreferrer"
              >
                WEBSITE
              </a>
            `
            : ""
        }


        ${
          maps
            ? `
              <a
                href="${escapeHtml(maps)}"
                target="_blank"
                rel="noopener noreferrer"
              >
                DIRECTIONS
              </a>
            `
            : ""
        }

      </div>

    </article>

  `;

}


/* =========================================================
   QUICK SEARCH CARDS
========================================================= */

document
  .querySelectorAll(".quick-card")
  .forEach(card => {

    card.addEventListener(
      "click",
      () => {

        const query =
          card.dataset.search;

        performSearch(query);

      }
    );

  });


/* =========================================================
   ASK BUTTON
========================================================= */

document
  .getElementById("askButton")
  .addEventListener(
    "click",
    () => performSearch()
  );


/* =========================================================
   ENTER TO SEARCH
========================================================= */

document
  .getElementById("mainSearch")
  .addEventListener(
    "keydown",
    event => {

      if (event.key === "Enter") {

        event.preventDefault();

        performSearch();

      }

    }
  );


/* =========================================================
   BROWSE BCR
========================================================= */

document
  .getElementById("browseCard")
  .addEventListener(
    "click",
    () => {

      scrollToSection(
        "directorySection"
      );

    }
  );


/* =========================================================
   NEAR ME
========================================================= */

document
  .getElementById("nearMeCard")
  .addEventListener(
    "click",
    () => {

      const location =
        document.getElementById(
          "searchLocation"
        );


      if (
        location.value === "anywhere"
      ) {

        location.value =
          "Blackpool";

      }


      document
        .getElementById("mainSearch")
        .focus();


      document
        .getElementById("mainSearch")
        .placeholder =
          "What do you need near you?";

    }
  );


/* =========================================================
   CLEAR RESULTS
========================================================= */

document
  .getElementById("clearResults")
  .addEventListener(
    "click",
    () => {

      document
        .getElementById("resultsSection")
        .style.display = "none";


      document
        .getElementById("askResults")
        .innerHTML = "";


      document
        .getElementById("resultsCount")
        .textContent = "";

    }
  );


/* =========================================================
   LOAD BCR DIRECTORY
========================================================= */

async function loadDirectory() {

  const container =
    document.getElementById(
      "businessDirectory"
    );


  try {

    /*
      IMPORTANT:
      The businesses table DOES NOT contain a featured column.

      Therefore we only order by business_name.
    */

    const url =
      SUPABASE_URL +
      "/rest/v1/businesses" +
      "?status=eq.approved" +
      "&order=business_name.asc";


    const response =
      await fetch(
        url,
        {
          method: "GET",

          headers: {
            "apikey": SUPABASE_KEY,
            "Accept": "application/json"
          }
        }
      );


    if (!response.ok) {

      const errorText =
        await response.text();

      throw new Error(
        errorText ||
        `Directory request failed (${response.status})`
      );

    }


    const businesses =
      await response.json();


    if (
      !Array.isArray(businesses) ||
      businesses.length === 0
    ) {

      container.innerHTML = `

        <div class="notice">

          No approved BCR businesses are currently listed.

        </div>

      `;

      return;

    }


    container.innerHTML =
      businesses
        .map(
          business =>
            renderBusinessCard({
              ...business,
              partner: true,
              source: "bcr"
            })
        )
        .join("");


  } catch (error) {

    console.error(
      "Directory error:",
      error
    );


    container.innerHTML = `

      <div class="notice error">

        The BCR directory could not be loaded.

        <br><br>

        ${escapeHtml(
          error && error.message
            ? error.message
            : "Unknown directory error."
        )}

      </div>

    `;

  }

}


/* =========================================================
   BUSINESS REGISTRATION
========================================================= */

document
  .getElementById("businessForm")
  .addEventListener(
    "submit",
    async event => {

      event.preventDefault();


      const message =
        document.getElementById(
          "businessFormMessage"
        );


      message.innerHTML = `

        <div class="notice">

          Sending registration...

        </div>

      `;


      /*
        These are ONLY columns that actually exist
        in public.businesses.
      */

      const business = {

        business_name:
          document
            .getElementById(
              "businessName"
            )
            .value
            .trim(),


        category:
          document
            .getElementById(
              "businessCategory"
            )
            .value
            .trim(),


        description:
          document
            .getElementById(
              "businessDescription"
            )
            .value
            .trim(),


        address:
          document
            .getElementById(
              "businessAddress"
            )
            .value
            .trim(),


        area:
          document
            .getElementById(
              "businessArea"
            )
            .value
            .trim(),


        phone:
          document
            .getElementById(
              "businessPhone"
            )
            .value
            .trim(),


        email:
          document
            .getElementById(
              "businessEmail"
            )
            .value
            .trim(),


        website:
          document
            .getElementById(
              "businessWebsite"
            )
            .value
            .trim(),


        status: "pending"

      };


      try {

        const response =
          await fetch(
            SUPABASE_URL +
            "/rest/v1/businesses",
            {
              method: "POST",

              headers: {
                "Content-Type":
                  "application/json",

                "apikey":
                  SUPABASE_KEY,

                "Prefer":
                  "return=minimal"
              },

              body:
                JSON.stringify(
                  business
                )
            }
          );


        if (!response.ok) {

          const text =
            await response.text();

          throw new Error(
            text ||
            `Registration failed (${response.status})`
          );

        }


        message.innerHTML = `

          <div class="notice success">

            <strong>
              Registration received.
            </strong>

            <br><br>

            Your business has been submitted
            for approval.

          </div>

        `;


        event.target.reset();


        /*
          Refresh directory in case the
          registration is subsequently approved.
        */

        loadDirectory();


      } catch (error) {

        console.error(
          "Registration error:",
          error
        );


        message.innerHTML = `

          <div class="notice error">

            <strong>
              Registration could not be submitted.
            </strong>

            <br><br>

            ${escapeHtml(
              error && error.message
                ? error.message
                : "Unknown registration error."
            )}

          </div>

        `;

      }

    }
  );


/* =========================================================
   ADVERTISING REQUEST
========================================================= */

/*
  IMPORTANT:

  advertising_campaigns requires:
  business_id
  package_id
  term_weeks
  weekly_plays
  weekly_price
  campaign_total

  The form does not have those values yet.

  Therefore we DO NOT insert fake/incomplete data
  into advertising_campaigns.

  Instead, this form creates an email request.

  Replace the email address below with the address
  you want advertising enquiries sent to.
*/

const ADVERTISING_EMAIL =
  "hello@bcrstudio.co.uk";


document
  .getElementById("advertisingForm")
  .addEventListener(
    "submit",
    event => {

      event.preventDefault();


      const businessName =
        document
          .getElementById(
            "adBusinessName"
          )
          .value
          .trim();


      const email =
        document
          .getElementById(
            "adEmail"
          )
          .value
          .trim();


      const details =
        document
          .getElementById(
            "adDetails"
          )
          .value
          .trim();


      const message =
        document.getElementById(
          "advertisingMessage"
        );


      if (
        !businessName ||
        !email ||
        !details
      ) {

        message.innerHTML = `

          <div class="notice error">

            Please complete all advertising fields.

          </div>

        `;

        return;

      }


      const subject =
        encodeURIComponent(
          "BCR AI Advertising Request - " +
          businessName
        );


      const body =
        encodeURIComponent(
          "Business Name: " +
          businessName +
          "\n\n" +
          "Email: " +
          email +
          "\n\n" +
          "Advertising Details:\n" +
          details
        );


      const mailto =
        "mailto:" +
        ADVERTISING_EMAIL +
        "?subject=" +
        subject +
        "&body=" +
        body;


      window.location.href =
        mailto;


      message.innerHTML = `

        <div class="notice success">

          <strong>
            Advertising request prepared.
          </strong>

          <br><br>

          Your email application should now open
          with the request ready to send.

        </div>

      `;

    }
  );


/* =========================================================
   INITIALISE
========================================================= */

loadDirectory();

</script>

</body>
</html>
