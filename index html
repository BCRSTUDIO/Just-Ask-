async function loadDirectory() {

  const container =
    document.getElementById(
      "businessDirectory"
    );


  try {

    const businesses =
      await getApprovedBusinesses();


    if (
      !Array.isArray(
        businesses
      ) ||
      !businesses.length
    ) {

      container.innerHTML = `
        <div class="notice">
          No approved BCR businesses
          are currently listed.
        </div>
      `;

      return;

    }


    container.innerHTML =
      businesses
        .map(
          business =>
            renderBusinessCard({
              ...business,
              partner: true
            })
        )
        .join("");


  } catch (error) {

    console.error(
      "Directory error:",
      error
    );


    container.innerHTML = `
      <div class="notice">

        <strong>
          The BCR directory could not
          be loaded.
        </strong>

        <br><br>

        ${escapeHtml(
          error.message
        )}

      </div>
    `;

  }

}


