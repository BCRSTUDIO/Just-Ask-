<script>
/* ============================================================
   SUPABASE CONFIGURATION
   ============================================================ */

const SUPABASE_URL =
  "https://mqnzubsfgvdnndfwhpcz.supabase.co";

const SUPABASE_KEY =
  "sb_publishable_oEf2PGkToQHsw_Tvo-faAA_L9uS1aX6";

/*
  IMPORTANT:
  This is the NEW function.
  Do NOT change this back to smooth-endpoint.
*/
const AI_SEARCH_URL =
  SUPABASE_URL + "/functions/v1/bcr-search";


/* ============================================================
   SMALL HELPERS
   ============================================================ */

function escapeHtml(value) {
  if (value === null || value === undefined) return "";

  return String(value)
    .replace(/&/g, "&amp;")
    .replace(/</g, "&lt;")
    .replace(/>/g, "&gt;")
    .replace(/"/g, "&quot;")
    .replace(/'/g, "&#039;");
}

function setMessage(element, message, type) {
  element.textContent = message;
  element.className = "form-message show " + type;
}

function normaliseWebsite(url) {
  if (!url) return "";

  const trimmed = String(url).trim();

  if (!trimmed) return "";

  if (
    trimmed.startsWith("http://") ||
    trimmed.startsWith("https://")
  ) {
    return trimmed;
  }

  return "https://" + trimmed;
}


/* ============================================================
   BUSINESS CARD
   ============================================================ */

function renderBusinessCard(business) {

  const name =
    business.business_name ||
    business.name ||
    "Local Business";

  const category =
    business.category ||
    "Local business";

  const description =
    business.description ||
    "";

  const address =
    business.address ||
    "";

  const area =
    business.area ||
    "";

  const postcode =
    business.postcode ||
    "";

  const phone =
    business.phone ||
    "";

  const website =
    business.website ||
    "";

  const openingHours =
    business.opening_hours ||
    "";

  const locationText =
    [address, area, postcode]
      .filter(Boolean)
      .join(", ");

  let html = "";

  html += '<article class="business-card">';

  html +=
    "<h3>" +
    escapeHtml(name) +
    "</h3>";

  html +=
    '<div class="category">' +
    escapeHtml(category) +
    "</div>";

  if (description) {
    html +=
      "<p>" +
      escapeHtml(description) +
      "</p>";
  }

  if (locationText) {
    html +=
      "<p>📍 " +
      escapeHtml(locationText) +
      "</p>";
  }

  if (phone) {
    html +=
      "<p>☎ " +
      escapeHtml(phone) +
      "</p>";
  }

  if (openingHours) {
    html +=
      "<p>🕒 " +
      escapeHtml(openingHours) +
      "</p>";
  }

  html += '<div class="business-actions">';

  if (phone) {
    html +=
      '<a href="tel:' +
      encodeURIComponent(phone) +
      '">Call</a>';
  }

  if (website) {
    const safeWebsite = normaliseWebsite(website);

    html +=
      '<a href="' +
      escapeHtml(safeWebsite) +
      '" target="_blank" rel="noopener noreferrer">Website</a>';
  }

  if (locationText) {
    const mapsQuery = encodeURIComponent(locationText);

    html +=
      '<a href="https://www.google.com/maps/search/?api=1&query=' +
      mapsQuery +
      '" target="_blank" rel="noopener noreferrer">Maps</a>';
  }

  html += "</div>";

  html += "</article>";

  return html;
}


/* ============================================================
   SEARCH
   ============================================================ */

async function performSearch(query, location) {

  const resultsSection =
    document.getElementById("results");

  const resultsGrid =
    document.getElementById("resultsGrid");

  const resultsStatus =
    document.getElementById("resultsStatus");

  const resultsSubtitle =
    document.getElementById("resultsSubtitle");

  resultsSection.classList.add("show");

  resultsGrid.innerHTML = "";

  resultsStatus.className = "status";

  resultsStatus.innerHTML =
    '<span class="loading">' +
    '<span class="dot"></span>' +
    " Searching..." +
    "</span>";

  resultsSubtitle.textContent =
    "Searching for " + query +
    (location && location !== "anywhere"
      ? " near " + location
      : "");

  resultsSection.scrollIntoView({
    behavior: "smooth",
    block: "start"
  });

  try {

    const response = await fetch(AI_SEARCH_URL, {
      method: "POST",
      headers: {
        "Content-Type": "application/json",
        "Accept": "application/json",
        "apikey": SUPABASE_KEY
      },
      body: JSON.stringify({
        query: query,
        location: location || "anywhere"
      })
    });

    const rawText = await response.text();

    let data = {};

    try {
      data = rawText
        ? JSON.parse(rawText)
        : {};
    } catch (parseError) {

      throw new Error(
        "The search function returned an invalid response."
      );
    }

    if (!response.ok) {

      const backendError =
        data.error ||
        data.message ||
        "Search function returned HTTP " +
        response.status;

      throw new Error(backendError);
    }

    const results =
      Array.isArray(data.results)
        ? data.results
        : Array.isArray(data.businesses)
          ? data.businesses
          : [];

    if (!results.length) {

      resultsStatus.textContent =
        "No matching businesses were found.";

      return;
    }

    resultsStatus.textContent =
      results.length +
      " business" +
      (results.length === 1 ? "" : "es") +
      " found.";

    resultsGrid.innerHTML =
      results
        .map(renderBusinessCard)
        .join("");

  } catch (error) {

    console.error("BCR search error:", error);

    resultsStatus.className =
      "status error";

    resultsStatus.textContent =
      "Search could not be completed: " +
      (error.message || "Unknown error");

    /*
      If the Edge Function is unavailable, try the
      public businesses table directly as a fallback.
    */
    try {

      const fallbackResults =
        await directBusinessSearch(query, location);

      if (fallbackResults.length) {

        resultsStatus.className = "status";

        resultsStatus.textContent =
          fallbackResults.length +
          " registered business" +
          (fallbackResults.length === 1 ? "" : "es") +
          " found.";

        resultsGrid.innerHTML =
          fallbackResults
            .map(renderBusinessCard)
            .join("");

      } else {

        resultsStatus.textContent =
          "The AI search service is unavailable and no matching registered businesses were found.";

      }

    } catch (fallbackError) {

      console.error(
        "Fallback search error:",
        fallbackError
      );
    }
  }
}


/* ============================================================
   DIRECT SUPABASE SEARCH FALLBACK
   ============================================================ */

async function directBusinessSearch(query, location) {

  const terms =
    String(query || "")
      .trim()
      .split(/\s+/)
      .filter(Boolean);

  const params =
    new URLSearchParams();

  params.set(
    "select",
    "id,business_name,category,description,address,area,postcode,phone,email,website,opening_hours"
  );

  params.set(
    "status",
    "eq.approved"
  );

  params.set(
    "order",
    "business_name.asc"
  );

  /*
    Search the main text columns.
  */
  if (terms.length) {

    const searchParts = [];

    terms.forEach(function(term) {

      const safe =
        term
          .replace(/[%(),]/g, "")
          .trim();

      if (!safe) return;

      searchParts.push(
        "business_name.ilike.*" + safe + "*"
      );

      searchParts.push(
        "category.ilike.*" + safe + "*"
      );

      searchParts.push(
        "description.ilike.*" + safe + "*"
      );

      searchParts.push(
        "area.ilike.*" + safe + "*"
      );

      searchParts.push(
        "address.ilike.*" + safe + "*"
      );
    });

    if (searchParts.length) {
      params.set(
        "or",
        "(" + searchParts.join(",") + ")"
      );
    }
  }

  const url =
    SUPABASE_URL +
    "/rest/v1/businesses?" +
    params.toString();

  const response =
    await fetch(url, {
      method: "GET",
      headers: {
        "Accept": "application/json",
        "apikey": SUPABASE_KEY
      }
    });

  if (!response.ok) {

    const errorText =
      await response.text();

    throw new Error(
      "Directory search failed: HTTP " +
      response.status +
      " " +
      errorText
    );
  }

  let results =
    await response.json();

  /*
    Apply location filtering client-side.
    This avoids constructing a second PostgREST
    OR expression that could conflict with the
    main search expression.
  */
  const cleanLocation =
    String(location || "")
      .trim()
      .toLowerCase();

  if (
    cleanLocation &&
    cleanLocation !== "anywhere"
  ) {

    const locationResults =
      results.filter(function(business) {

        const searchable =
          [
            business.address,
            business.area,
            business.postcode
          ]
          .filter(Boolean)
          .join(" ")
          .toLowerCase();

        return searchable.includes(
          cleanLocation
        );
      });

    /*
      Only replace the results if the location
      actually produced matches.
    */
    if (locationResults.length) {
      results = locationResults;
    }
  }

  return results;
}


/* ============================================================
   DIRECTORY
   ============================================================ */

async function loadDirectory() {

  const status =
    document.getElementById("directoryStatus");

  const grid =
    document.getElementById("directoryGrid");

  status.className = "status";

  status.innerHTML =
    '<span class="loading">' +
    '<span class="dot"></span>' +
    " Loading directory..." +
    "</span>";

  grid.innerHTML = "";

  try {

    const url =
      SUPABASE_URL +
      "/rest/v1/businesses" +
      "?select=id,business_name,category,description,address,area,postcode,phone,email,website,opening_hours" +
      "&status=eq.approved" +
      "&order=business_name.asc";

    const response =
      await fetch(url, {
        method: "GET",
        headers: {
          "Accept": "application/json",
          "apikey": SUPABASE_KEY
        }
      });

    if (!response.ok) {

      const errorText =
        await response.text();

      throw new Error(
        "Directory failed: HTTP " +
        response.status +
        " " +
        errorText
      );
    }

    const businesses =
      await response.json();

    if (!businesses.length) {

      status.textContent =
        "No approved businesses are currently listed.";

      return;
    }

    status.textContent =
      businesses.length +
      " approved business" +
      (businesses.length === 1 ? "" : "es") +
      " listed.";

    grid.innerHTML =
      businesses
        .map(renderBusinessCard)
        .join("");

  } catch (error) {

    console.error(
      "Directory error:",
      error
    );

    status.className =
      "status error";

    status.textContent =
      "Could not load the business directory: " +
      (error.message || "Unknown error");
  }
}


/* ============================================================
   BUSINESS REGISTRATION
   ============================================================ */

async function registerBusiness(event) {

  event.preventDefault();

  const message =
    document.getElementById(
      "registerMessage"
    );

  message.className =
    "form-message show";

  message.textContent =
    "Submitting business...";

  const business = {

    business_name:
      document.getElementById(
        "businessName"
      ).value.trim(),

    category:
      document.getElementById(
        "businessCategory"
      ).value.trim(),

    description:
      document.getElementById(
        "businessDescription"
      ).value.trim(),

    address:
      document.getElementById(
        "businessAddress"
      ).value.trim(),

    area:
      document.getElementById(
        "businessArea"
      ).value.trim(),

    postcode:
      document.getElementById(
        "businessPostcode"
      ).value.trim(),

    phone:
      document.getElementById(
        "businessPhone"
      ).value.trim(),

    email:
      document.getElementById(
        "businessEmail"
      ).value.trim(),

    website:
      document.getElementById(
        "businessWebsite"
      ).value.trim(),

    opening_hours:
      document.getElementById(
        "businessHours"
      ).value.trim(),

    status: "pending"
  };

  try {

    const response =
      await fetch(
        SUPABASE_URL +
        "/rest/v1/businesses",
        {
          method: "POST",
          headers: {
            "Content-Type":
              "application/json",
            "Accept":
              "application/json",
            "apikey":
              SUPABASE_KEY,
            "Prefer":
              "return=minimal"
          },
          body:
            JSON.stringify(business)
        }
      );

    const text =
      await response.text();

    if (!response.ok) {

      let errorMessage =
        "Registration failed.";

      try {

        const errorData =
          JSON.parse(text);

        errorMessage =
          errorData.message ||
          errorData.error ||
          errorData.hint ||
          errorMessage;

      } catch (_) {}

      throw new Error(
        errorMessage
      );
    }

    setMessage(
      message,
      "Business submitted successfully. It will appear in the directory after approval.",
      "success"
    );

    document
      .getElementById("registerForm")
      .reset();

  } catch (error) {

    console.error(
      "Registration error:",
      error
    );

    setMessage(
      message,
      "Could not submit your business: " +
      (error.message || "Unknown error"),
      "error"
    );
  }
}


/* ============================================================
   ADVERTISING REQUEST
   ============================================================ */

function submitAdvertisingRequest(event) {

  event.preventDefault();

  const message =
    document.getElementById(
      "advertiseMessage"
    );

  const business =
    document.getElementById(
      "advertBusiness"
    ).value.trim();

  const email =
    document.getElementById(
      "advertEmail"
    ).value.trim();

  const details =
    document.getElementById(
      "advertDetails"
    ).value.trim();

  /*
    Your database has campaign/package tables,
    but an anonymous advertising-request table
    does not exist.

    Therefore this form prepares an email instead
    of incorrectly inserting into advertising_campaigns.
  */

  const subject =
    encodeURIComponent(
      "BCR AI Advertising Request - " +
      business
    );

  const body =
    encodeURIComponent(
      "Business: " +
      business +
      "\n\nEmail: " +
      email +
      "\n\nAdvertising requirements:\n" +
      details
    );

  /*
    Change this address later to the email address
    you want to receive advertising enquiries at.
  */
  const enquiryEmail =
    "hello@justaskbcr.ai";

  window.location.href =
    "mailto:" +
    enquiryEmail +
    "?subject=" +
    subject +
    "&body=" +
    body;

  setMessage(
    message,
    "Your advertising request has been prepared in your email application.",
    "success"
  );
}


/* ============================================================
   EVENTS
   ============================================================ */

document
  .getElementById("searchButton")
  .addEventListener(
    "click",
    function() {

      const query =
        document
          .getElementById("searchInput")
          .value
          .trim();

      const location =
        document
          .getElementById("locationInput")
          .value
          .trim();

      if (!query) {

        document
          .getElementById("searchInput")
          .focus();

        return;
      }

      performSearch(
        query,
        location || "anywhere"
      );
    }
  );


document
  .getElementById("searchInput")
  .addEventListener(
    "keydown",
    function(event) {

      if (event.key === "Enter") {

        event.preventDefault();

        document
          .getElementById("searchButton")
          .click();
      }
    }
  );


document
  .querySelectorAll(".quick-card")
  .forEach(function(card) {

    card.addEventListener(
      "click",
      function() {

        const query =
          card.dataset.query ||
          "";

        document
          .getElementById("searchInput")
          .value = query;

        performSearch(
          query,
          document
            .getElementById("locationInput")
            .value
            .trim() || "anywhere"
        );
      }
    );
  });


document
  .getElementById("registerForm")
  .addEventListener(
    "submit",
    registerBusiness
  );


document
  .getElementById("advertiseForm")
  .addEventListener(
    "submit",
    submitAdvertisingRequest
  );


/* ============================================================
   INITIAL LOAD
   ============================================================ */

loadDirectory();

</script>

