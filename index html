<!DOCTYPE html>

<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title>JUST ASK BCR AI</title>
  <meta
    name="description"
    content="JUST ASK BCR AI — discover local businesses, services and places with AI-powered search."
  />

  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    :root {
      --bg: #05070d;
      --bg-soft: #0a0e18;
      --panel: rgba(13, 18, 30, 0.88);
      --panel-2: rgba(18, 24, 40, 0.92);
      --border: rgba(255, 255, 255, 0.09);
      --text: #f5f7fb;
      --muted: #9aa4b8;
      --accent: #7c5cff;
      --accent-2: #00d4ff;
      --success: #32d583;
      --danger: #ff5c7a;
      --warning: #ffbf47;
      --shadow: 0 25px 80px rgba(0, 0, 0, 0.45);
      --radius: 20px;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      min-height: 100vh;
      font-family:
        Inter,
        ui-sans-serif,
        system-ui,
        -apple-system,
        BlinkMacSystemFont,
        "Segoe UI",
        sans-serif;
      color: var(--text);
      background:
        radial-gradient(circle at 15% 10%, rgba(124, 92, 255, 0.18), transparent 32%),
        radial-gradient(circle at 85% 20%, rgba(0, 212, 255, 0.12), transparent 28%),
        linear-gradient(180deg, #05070d 0%, #070a12 55%, #05070d 100%);
      line-height: 1.6;
    }

    body::before {
      content: "";
      position: fixed;
      inset: 0;
      pointer-events: none;
      background-image:
        linear-gradient(rgba(255,255,255,0.018) 1px, transparent 1px),
        linear-gradient(90deg, rgba(255,255,255,0.018) 1px, transparent 1px);
      background-size: 50px 50px;
      mask-image: linear-gradient(to bottom, black, transparent 85%);
      z-index: -1;
    }

    a {
      color: inherit;
      text-decoration: none;
    }

    button,
    input,
    textarea,
    select {
      font: inherit;
    }

    button {
      cursor: pointer;
    }

    .container {
      width: min(1180px, calc(100% - 40px));
      margin: 0 auto;
    }

    .site-header {
      position: sticky;
      top: 0;
      z-index: 100;
      border-bottom: 1px solid var(--border);
      background: rgba(5, 7, 13, 0.78);
      backdrop-filter: blur(18px);
    }

    .nav {
      min-height: 74px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 24px;
    }

    .logo {
      display: inline-flex;
      align-items: center;
      gap: 11px;
      font-weight: 900;
      letter-spacing: -0.03em;
      white-space: nowrap;
    }

    .logo-mark {
      width: 36px;
      height: 36px;
      border-radius: 12px;
      display: grid;
      place-items: center;
      background: linear-gradient(135deg, var(--accent), var(--accent-2));
      box-shadow: 0 0 35px rgba(124, 92, 255, 0.35);
      color: #fff;
      font-weight: 950;
    }

    .logo-text {
      font-size: 15px;
    }

    .nav-links {
      display: flex;
      align-items: center;
      gap: 25px;
      color: var(--muted);
      font-size: 14px;
    }

    .nav-links a {
      transition: color 0.2s ease;
    }

    .nav-links a:hover {
      color: #fff;
    }

    .nav-cta {
      padding: 10px 16px;
      border: 1px solid rgba(124, 92, 255, 0.45);
      border-radius: 12px;
      color: #fff !important;
      background: rgba(124, 92, 255, 0.12);
    }

    .hero {
      padding: 100px 0 70px;
      text-align: center;
    }

    .eyebrow {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 7px 12px;
      border: 1px solid var(--border);
      border-radius: 999px;
      background: rgba(255,255,255,0.035);
      color: #c6ccda;
      font-size: 12px;
      font-weight: 700;
      letter-spacing: 0.04em;
      text-transform: uppercase;
    }

    .eyebrow-dot {
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background: var(--success);
      box-shadow: 0 0 12px rgba(50, 213, 131, 0.8);
    }

    .hero h1 {
      max-width: 900px;
      margin: 25px auto 18px;
      font-size: clamp(42px, 7vw, 78px);
      line-height: 0.98;
      letter-spacing: -0.065em;
      font-weight: 950;
    }

    .gradient-text {
      background: linear-gradient(110deg, #fff 15%, #b6a8ff 50%, #63e8ff 90%);
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
    }

    .hero p {
      max-width: 680px;
      margin: 0 auto;
      color: var(--muted);
      font-size: 18px;
    }

    .search-shell {
      width: min(900px, 100%);
      margin: 38px auto 0;
      padding: 10px;
      border: 1px solid rgba(124, 92, 255, 0.35);
      border-radius: 22px;
      background:
        linear-gradient(rgba(12, 16, 28, 0.92), rgba(12, 16, 28, 0.92)) padding-box,
        linear-gradient(110deg, rgba(124, 92, 255, 0.7), rgba(0, 212, 255, 0.35)) border-box;
      box-shadow: var(--shadow);
    }

    .search-row {
      display: grid;
      grid-template-columns: 1fr 0.55fr auto;
      gap: 10px;
    }

    .input-wrap {
      position: relative;
    }

    .input-wrap input {
      width: 100%;
      height: 58px;
      border: 1px solid var(--border);
      border-radius: 15px;
      outline: none;
      padding: 0 17px;
      color: #fff;
      background: rgba(255,255,255,0.045);
      transition: border-color 0.2s ease, background 0.2s ease;
    }

    .input-wrap input:focus {
      border-color: rgba(124, 92, 255, 0.7);
      background: rgba(255,255,255,0.065);
    }

    .input-wrap input::placeholder {
      color: #6f788c;
    }

    .search-button {
      min-width: 145px;
      height: 58px;
      border: 0;
      border-radius: 15px;
      color: #fff;
      font-weight: 800;
      background: linear-gradient(135deg, var(--accent), #5b8cff);
      box-shadow: 0 12px 30px rgba(124, 92, 255, 0.28);
      transition: transform 0.2s ease, filter 0.2s ease;
    }

    .search-button:hover {
      transform: translateY(-1px);
      filter: brightness(1.08);
    }

    .search-button:disabled {
      cursor: not-allowed;
      opacity: 0.65;
      transform: none;
    }

    .search-hint {
      margin-top: 13px;
      color: #687287;
      font-size: 12px;
    }

    .section {
      padding: 70px 0;
    }

    .section-header {
      margin-bottom: 28px;
    }

    .section-header h2 {
      font-size: clamp(28px, 4vw, 42px);
      line-height: 1.05;
      letter-spacing: -0.04em;
    }

    .section-header p {
      margin-top: 9px;
      color: var(--muted);
    }

    .status-box {
      display: none;
      margin: 20px 0;
      padding: 15px 17px;
      border: 1px solid var(--border);
      border-radius: 14px;
      background: rgba(255,255,255,0.035);
      color: #cbd2df;
      font-size: 14px;
    }

    .status-box.show {
      display: block;
    }

    .status-box.loading {
      border-color: rgba(124, 92, 255, 0.35);
    }

    .status-box.success {
      border-color: rgba(50, 213, 131, 0.35);
    }

    .status-box.error {
      border-color: rgba(255, 92, 122, 0.35);
      color: #ffb6c3;
    }

    .results-grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 18px;
    }

    .business-card {
      min-height: 250px;
      padding: 22px;
      border: 1px solid var(--border);
      border-radius: var(--radius);
      background:
        linear-gradient(180deg, rgba(255,255,255,0.045), rgba(255,255,255,0.018));
      box-shadow: 0 12px 40px rgba(0,0,0,0.18);
      transition: transform 0.22s ease, border-color 0.22s ease;
    }

    .business-card:hover {
      transform: translateY(-3px);
      border-color: rgba(124, 92, 255, 0.3);
    }

    .card-top {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      gap: 15px;
    }

    .card-icon {
      width: 44px;
      height: 44px;
      display: grid;
      place-items: center;
      flex: 0 0 auto;
      border-radius: 13px;
      background: rgba(124, 92, 255, 0.13);
      border: 1px solid rgba(124, 92, 255, 0.18);
      font-size: 20px;
    }

    .card-category {
      margin-top: 2px;
      color: #8c97ab;
      font-size: 12px;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      font-weight: 800;
    }

    .business-card h3 {
      margin-top: 5px;
      font-size: 19px;
      line-height: 1.2;
    }

    .business-description {
      margin-top: 15px;
      color: #9ba5b8;
      font-size: 14px;
    }

    .business-meta {
      display: grid;
      gap: 7px;
      margin-top: 17px;
      color: #8f99ac;
      font-size: 13px;
    }

    .business-meta span {
      display: block;
      overflow-wrap: anywhere;
    }

    .card-actions {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      margin-top: 17px;
    }

    .small-button {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: 36px;
      padding: 7px 11px;
      border-radius: 10px;
      border: 1px solid var(--border);
      color: #d9deea;
      background: rgba(255,255,255,0.04);
      font-size: 12px;
      font-weight: 700;
    }

    .small-button:hover {
      border-color: rgba(124, 92, 255, 0.4);
    }

    .empty-state {
      padding: 55px 25px;
      text-align: center;
      border: 1px dashed rgba(255,255,255,0.12);
      border-radius: var(--radius);
      color: var(--muted);
    }

    .empty-state strong {
      display: block;
      margin-bottom: 7px;
      color: #fff;
      font-size: 17px;
    }

    .ai-answer {
      display: none;
      margin-bottom: 25px;
      padding: 24px;
      border: 1px solid rgba(124, 92, 255, 0.25);
      border-radius: var(--radius);
      background:
        radial-gradient(circle at top right, rgba(124, 92, 255, 0.12), transparent 40%),
        rgba(255,255,255,0.025);
    }

    .ai-answer.show {
      display: block;
    }

    .ai-answer-label {
      color: #9e91ff;
      font-size: 11px;
      font-weight: 900;
      letter-spacing: 0.12em;
      text-transform: uppercase;
    }

    .ai-answer-text {
      margin-top: 9px;
      color: #e8ebf3;
      white-space: pre-wrap;
    }

    .directory-toolbar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 15px;
      margin-bottom: 22px;
    }

    .directory-search {
      width: min(420px, 100%);
      height: 46px;
      padding: 0 14px;
      border: 1px solid var(--border);
      border-radius: 12px;
      outline: none;
      color: #fff;
      background: rgba(255,255,255,0.04);
    }

    .directory-search:focus {
      border-color: rgba(124, 92, 255, 0.55);
    }

    .register-section {
      padding-bottom: 100px;
    }

    .register-grid {
      display: grid;
      grid-template-columns: 0.85fr 1.15fr;
      gap: 25px;
      align-items: start;
    }

    .register-copy,
    .form-card {
      padding: 30px;
      border: 1px solid var(--border);
      border-radius: var(--radius);
      background: rgba(255,255,255,0.025);
    }

    .register-copy h2 {
      font-size: 35px;
      line-height: 1.05;
      letter-spacing: -0.04em;
    }

    .register-copy p {
      margin-top: 15px;
      color: var(--muted);
    }

    .register-points {
      display: grid;
      gap: 12px;
      margin-top: 25px;
    }

    .register-point {
      display: flex;
      gap: 11px;
      color: #b7bfce;
      font-size: 14px;
    }

    .register-point::before {
      content: "✓";
      color: var(--success);
      font-weight: 900;
    }

    .form-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 14px;
    }

    .field {
      display: grid;
      gap: 7px;
    }

    .field.full {
      grid-column: 1 / -1;
    }

    .field label {
      color: #cbd2df;
      font-size: 12px;
      font-weight: 700;
    }

    .field input,
    .field textarea,
    .field select {
      width: 100%;
      border: 1px solid var(--border);
      border-radius: 11px;
      outline: none;
      padding: 12px 13px;
      color: #fff;
      background: rgba(255,255,255,0.04);
    }

    .field input,
    .field select {
      height: 46px;
    }

    .field textarea {
      min-height: 105px;
      resize: vertical;
    }

    .field input:focus,
    .field textarea:focus,
    .field select:focus {
      border-color: rgba(124, 92, 255, 0.55);
    }

    .field select option {
      color: #111;
    }

    .submit-button {
      width: 100%;
      height: 50px;
      margin-top: 17px;
      border: 0;
      border-radius: 12px;
      color: #fff;
      font-weight: 800;
      background: linear-gradient(135deg, var(--accent), #5b8cff);
    }

    .submit-button:disabled {
      opacity: 0.65;
      cursor: not-allowed;
    }

    .form-message {
      display: none;
      margin-top: 13px;
      padding: 11px 13px;
      border-radius: 10px;
      font-size: 13px;
    }

    .form-message.show {
      display: block;
    }

    .form-message.success {
      color: #b9f5d5;
      background: rgba(50, 213, 131, 0.08);
      border: 1px solid rgba(50, 213, 131, 0.2);
    }

    .form-message.error {
      color: #ffb6c3;
      background: rgba(255, 92, 122, 0.08);
      border: 1px solid rgba(255, 92, 122, 0.2);
    }

    footer {
      border-top: 1px solid var(--border);
      padding: 35px 0;
      color: #687287;
      font-size: 13px;
    }

    .footer-inner {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 20px;
    }

    .footer-links {
      display: flex;
      gap: 18px;
    }

    .footer-links a:hover {
      color: #fff;
    }

    .hidden {
      display: none !important;
    }

    @media (max-width: 900px) {
      .nav-links {
        display: none;
      }

      .search-row {
        grid-template-columns: 1fr;
      }

      .search-button {
        width: 100%;
      }

      .results-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }

      .register-grid {
        grid-template-columns: 1fr;
      }
    }

    @media (max-width: 620px) {
      .container {
        width: min(100% - 24px, 1180px);
      }

      .hero {
        padding: 70px 0 45px;
      }

      .hero h1 {
        font-size: 47px;
      }

      .hero p {
        font-size: 16px;
      }

      .section {
        padding: 50px 0;
      }

      .results-grid {
        grid-template-columns: 1fr;
      }

      .form-grid {
        grid-template-columns: 1fr;
      }

      .field.full {
        grid-column: auto;
      }

      .directory-toolbar {
        align-items: stretch;
        flex-direction: column;
      }

      .directory-search {
        width: 100%;
      }

      .footer-inner {
        align-items: flex-start;
        flex-direction: column;
      }
    }
  </style>

</head>

