  if (element) {

    element.scrollIntoView({
      behavior: "smooth",
      block: "start"
    });

  }

}


function supabaseHeaders(extra = {}) {

  return {
    "apikey": SUPABASE_KEY,
    "Accept": "application/json",
    ...extra
  };

}


/* =========================================================
   DATABASE
========================================================= */

async function getApprovedBusinesses() {

  const url =
    SUPABASE_URL +
    "/rest/v1/businesses" +
    "?status=eq.approved" +
    "&order=business_name.asc";


  const response =
    await fetch(
      url,
      {
        method: "GET",
        headers: supabaseHeaders()
      }
    );


  if (!response.ok) {

    const text =
      await response.text();

    throw new Error(
      text ||
      `Database request failed (${response.status})`
    );

  }


  return await response.json();

}


/* =========================================================
   SEARCH
========================================================= */

async function performSearch(
  customQuery = null
) {

  const searchInput =
    document.getElementById("mainSearch");

  const locationInput =
    document.getElementById("searchLocation");

  const resultsSection =
    document.getElementById("resultsSection");

  const resultsContainer =
    document.getElementById("askResults");

  const resultsCount =
    document.getElementById("resultsCount");

  const button =
    document.getElementById("askButton");


  const query =
    customQuery ||
    searchInput.value.trim();


  const location =
    locationInput.value ||
    "anywhere";


  if (!query) {

    searchInput.focus();

    return;

  }


  searchInput.value = query;

  resultsSection.style.display = "block";

  resultsContainer.innerHTML = `
    <div class="loading">
      <div class="spinner"></div>
      BCR AI is searching...
    </div>
  `;

  resultsCount.textContent = "";

  button.disabled = true;
  button.textContent = "SEARCHING...";


  resultsSection.scrollIntoView({
    behavior: "smooth",
    block: "start"
  });


  try {

    const businesses =
      await getApprovedBusinesses();


    const searchWords =
      query
        .toLowerCase()
        .split(/\s+/)
        .filter(Boolean);


    const locationWords =
      location === "anywhere"
        ? []
        : location
            .toLowerCase()
            .split(/\s+/)
            .filter(Boolean);


    const results =
      businesses
        .map(
          business => {

            const searchableText = [

              business.business_name,
              business.category,
              business.description,
              business.address,
              business.area,
              business.postcode

            ]
              .filter(Boolean)
              .join(" ")
              .toLowerCase();


            const locationText = [

              business.address,
              business.area,
              business.postcode

            ]
              .filter(Boolean)
              .join(" ")
              .toLowerCase();


            let score = 0;


            for (
              const word of searchWords
            ) {

              if (
                searchableText.includes(word)
              ) {

                score += 2;

              }


              if (
                String(
                  business.business_name || ""
                )
                  .toLowerCase()
                  .includes(word)
              ) {

                score += 5;

              }


              if (
                String(
                  business.category || ""
                )
                  .toLowerCase()
                  .includes(word)
              ) {

                score += 4;

              }


              if (
                String(
                  business.description || ""
                )
                  .toLowerCase()
                  .includes(word)
              ) {

                score += 2;

              }

            }


            if (
              locationWords.length
            ) {

              const locationMatch =
                locationWords.some(
                  word =>
                    locationText.includes(word)
                );


              if (locationMatch) {

                score += 5;

              } else {

                score -= 3;

              }

            }


            return {
              ...business,
              score
            };

          }
        )
        .filter(
          business =>
            business.score > 0
        )
        .sort(
          (a, b) => {

            if (
              b.score !== a.score
            ) {

              return b.score - a.score;

            }


            return String(
              a.business_name
            ).localeCompare(
              String(
                b.business_name
              )
            );

          }
        )
        .slice(0, 30);


    resultsCount.textContent =
      `${results.length} result${
        results.length === 1
          ? ""
          : "s"
      } found`;


    if (!results.length) {

      resultsContainer.innerHTML = `
        <div class="notice">

          <strong>
            No matching businesses found.
          </strong>

          <br><br>

          Try another search, category or location.

        </div>
      `;

      return;

    }


    renderBusinesses(
      results,
      resultsContainer
    );


  } catch (error) {

    console.error(
      "Search error:",
      error
    );


    resultsContainer.innerHTML = `
      <div class="notice">

        <strong>
          Search could not be completed.
        </strong>

        <br><br>

        ${escapeHtml(
          error.message
        )}

      </div>
    `;

  } finally {

    button.disabled = false;
    button.textContent = "ASK AI →";

  }

}


/* =========================================================
   BUSINESS CARDS
========================================================= */

function renderBusinesses(
  businesses,
  container
) {

  container.innerHTML = `

    <div class="results-grid">

      ${
        businesses
          .map(
            business =>
              renderBusinessCard(
                business
              )
          )
          .join("")
      }

    </div>

  `;

}


function renderBusinessCard(
  business
) {

  const name =
    business.business_name ||
    "Business";


  const category =
    business.category ||
    "";


  const address =
    business.address ||
    "";


  const phone =
    business.phone ||
    "";


  const email =
    business.email ||
    "";


  const website =
    business.website ||
    "";


  const description =
    business.description ||
    "";


  const partner =
    Boolean(
      business.partner
    );


  let websiteUrl =
    website;


  if (
    websiteUrl &&
    !websiteUrl.startsWith(
      "http://"
    ) &&
    !websiteUrl.startsWith(
      "https://"
    )
  ) {

    websiteUrl =
      "https://" +
      websiteUrl;

  }


  const mapsUrl =
    address
      ? "https://www.google.com/maps/search/?api=1&query=" +
        encodeURIComponent(address)
      : "";


  return `

    <article class="business-card">

      <div class="business-top">

        <div>

          <div class="business-name">

            ${escapeHtml(name)}

          </div>


          <div class="badges">

            ${
              partner
                ? `
                  <span class="badge badge-bcr">
                    BCR REGISTERED
                  </span>
                `
                : ""
            }

          </div>

        </div>

      </div>


      ${
        category
          ? `
            <div class="business-category">
              ${escapeHtml(category)}
            </div>
          `
          : ""
      }


      ${
        description
          ? `
            <div class="business-detail">
              ${escapeHtml(description)}
            </div>
          `
          : ""
      }


      ${
        address
          ? `
            <div class="business-detail">
              📍 ${escapeHtml(address)}
            </div>
          `
          : ""
      }


      ${
        phone
          ? `
            <div class="business-detail">
              ☎ ${escapeHtml(phone)}
            </div>
          `
          : ""
      }


      <div class="business-actions">

        ${
          phone
            ? `
              <a href="tel:${escapeHtml(phone)}">
                CALL
              </a>
            `
            : ""
        }


        ${
          email
            ? `
              <a href="mailto:${escapeHtml(email)}">
                EMAIL
              </a>
            `
            : ""
        }


        ${
          websiteUrl
            ? `
              <a
                href="${escapeHtml(websiteUrl)}"
                target="_blank"
                rel="noopener"
              >
                WEBSITE
              </a>
            `
            : ""
        }


        ${
          mapsUrl
            ? `
              <a
                href="${escapeHtml(mapsUrl)}"
                target="_blank"
                rel="noopener"
              >
                DIRECTIONS
              </a>
            `
            : ""
        }

      </div>

    </article>

  `;

}


