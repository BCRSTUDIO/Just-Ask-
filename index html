  <script>
    "use strict";

    /*
      ============================================================
      JUST ASK BCR AI — FRONTEND CONFIGURATION
      ============================================================

      IMPORTANT:

      1. SUPABASE_URL is already configured.
      2. Paste your EXISTING SUPABASE PUBLISHABLE KEY below.
      3. Do NOT put OpenAI, Google, service-role, or secret keys here.
      4. The AI backend is the Supabase Edge Function:
         Just-ask
    */

    const SUPABASE_URL =
      "https://mqnzubsfgvdnndfwhpcz.supabase.co";

    const SUPABASE_KEY =
      "PASTE_YOUR_EXISTING_SUPABASE_PUBLISHABLE_KEY_HERE";

    const AI_SEARCH_URL =
      SUPABASE_URL + "/functions/v1/Just-ask";

    const BUSINESSES_URL =
      SUPABASE_URL + "/rest/v1/businesses";


    /*
      ============================================================
      DOM ELEMENTS
      ============================================================
    */

    const searchForm =
      document.getElementById("searchForm");

    const searchQuery =
      document.getElementById("searchQuery");

    const searchLocation =
      document.getElementById("searchLocation");

    const searchButton =
      document.getElementById("searchButton");

    const searchStatus =
      document.getElementById("searchStatus");

    const aiAnswer =
      document.getElementById("aiAnswer");

    const aiAnswerText =
      document.getElementById("aiAnswerText");

    const resultsGrid =
      document.getElementById("resultsGrid");

    const directoryGrid =
      document.getElementById("directoryGrid");

    const directorySearch =
      document.getElementById("directorySearch");

    const directoryRefresh =
      document.getElementById("directoryRefresh");

    const businessForm =
      document.getElementById("businessForm");

    const businessSubmit =
      document.getElementById("businessSubmit");

    const businessMessage =
      document.getElementById("businessMessage");

    const currentYear =
      document.getElementById("currentYear");


    /*
      ============================================================
      BASIC HELPERS
      ============================================================
    */

    currentYear.textContent =
      new Date().getFullYear();


    function escapeHtml(value) {
      if (value === null || value === undefined) {
        return "";
      }

      return String(value)
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;")
        .replace(/'/g, "&#039;");
    }


    function normaliseUrl(url) {
      if (!url) {
        return "";
      }

      const value = String(url).trim();

      if (!value) {
        return "";
      }

      if (
        value.startsWith("http://") ||
        value.startsWith("https://")
      ) {
        return value;
      }

      return "https://" + value;
    }


    function setSearchStatus(message, type) {
      searchStatus.textContent = message;
      searchStatus.className = "status-box show";

      if (type) {
        searchStatus.classList.add(type);
      }
    }


    function clearSearchStatus() {
      searchStatus.textContent = "";
      searchStatus.className = "status-box";
    }


    function setBusinessMessage(message, type) {
      businessMessage.textContent = message;
      businessMessage.className =
        "form-message show " + type;
    }


    function clearBusinessMessage() {
      businessMessage.textContent = "";
      businessMessage.className = "form-message";
    }


    function getCategoryIcon(category) {
      const value =
        String(category || "").toLowerCase();

      if (
        value.includes("food") ||
        value.includes("restaurant") ||
        value.includes("cafe") ||
        value.includes("takeaway")
      ) {
        return "🍴";
      }

      if (
        value.includes("barber") ||
        value.includes("hair") ||
        value.includes("beauty")
      ) {
        return "✂️";
      }

      if (
        value.includes("shop") ||
        value.includes("retail") ||
        value.includes("store")
      ) {
        return "🛍️";
      }

      if (
        value.includes("car") ||
        value.includes("auto") ||
        value.includes("garage")
      ) {
        return "🚗";
      }

      if (
        value.includes("health") ||
        value.includes("doctor") ||
        value.includes("dental") ||
        value.includes("clinic")
      ) {
        return "⚕️";
      }

      if (
        value.includes("builder") ||
        value.includes("construction") ||
        value.includes("plumber") ||
        value.includes("electric")
      ) {
        return "🔧";
      }

      return "📍";
    }


    /*
      ============================================================
      API KEY CHECK
      ============================================================
    */

    function hasSupabaseKey() {
      return (
        SUPABASE_KEY &&
        SUPABASE_KEY !==
          "PASTE_YOUR_EXISTING_SUPABASE_PUBLISHABLE_KEY_HERE"
      );
    }


    /*
      ============================================================
      BUSINESS CARD
      ============================================================
    */

    function createBusinessCard(business) {
      const name =
        business.business_name ||
        business.name ||
        "Unnamed business";

      const category =
        business.category ||
        "Local business";

      const description =
        business.description ||
        "No description available.";

      const address =
        business.address ||
        "";

      const area =
        business.area ||
        "";

      const postcode =
        business.postcode ||
        "";

      const phone =
        business.phone ||
        "";

      const email =
        business.email ||
        "";

      const website =
        business.website ||
        "";

      const openingHours =
        business.opening_hours ||
        "";

      const finalAddress =
        [address, area, postcode]
          .filter(Boolean)
          .join(", ");

      const websiteUrl =
        normaliseUrl(website);

      let html = `
        <article class="business-card">

          <div class="card-top">

            <div>
              <div class="card-category">
                ${escapeHtml(category)}
              </div>

              <h3>
                ${escapeHtml(name)}
              </h3>
            </div>

            <div class="card-icon">
              ${getCategoryIcon(category)}
            </div>

          </div>

          <p class="business-description">
            ${escapeHtml(description)}
          </p>
      `;

      if (
        finalAddress ||
        phone ||
        email ||
        openingHours
      ) {
        html += `
          <div class="business-meta">
        `;

        if (finalAddress) {
          html += `
            <span>📍 ${escapeHtml(finalAddress)}</span>
          `;
        }

        if (phone) {
          html += `
            <span>☎ ${escapeHtml(phone)}</span>
          `;
        }

        if (email) {
          html += `
            <span>✉ ${escapeHtml(email)}</span>
          `;
        }

        if (openingHours) {
          html += `
            <span>🕒 ${escapeHtml(openingHours)}</span>
          `;
        }

        html += `
          </div>
        `;
      }

      if (websiteUrl || phone) {
        html += `
          <div class="card-actions">
        `;

        if (websiteUrl) {
          html += `
            <a
              class="small-button"
              href="${escapeHtml(websiteUrl)}"
              target="_blank"
              rel="noopener noreferrer"
            >
              Website
            </a>
          `;
        }

        if (phone) {
          html += `
            <a
              class="small-button"
              href="tel:${escapeHtml(phone)}"
            >
              Call
            </a>
          `;
        }

        html += `
          </div>
        `;
      }

      html += `
        </article>
      `;

      return html;
    }


    /*
      ============================================================
      RENDER RESULTS
      ============================================================
    */

    function renderResults(items) {
      if (!Array.isArray(items) || items.length === 0) {
        resultsGrid.innerHTML = `
          <div class="empty-state">
            <strong>No matching businesses found</strong>
            Try a broader search or another location.
          </div>
        `;

        return;
      }

      resultsGrid.innerHTML =
        items
          .map(createBusinessCard)
          .join("");
    }


    /*
      ============================================================
      AI SEARCH
      ============================================================
    */

    async function performAISearch(query, location) {

      if (!hasSupabaseKey()) {
        setSearchStatus(
          "Add your Supabase publishable key to SUPABASE_KEY in index.html before searching.",
          "error"
        );

        return;
      }

      searchButton.disabled = true;
      searchButton.textContent = "Searching...";

      setSearchStatus(
        "JUST ASK AI is searching the local directory...",
        "loading"
      );

      aiAnswer.classList.remove("show");
      aiAnswerText.textContent = "";

      resultsGrid.innerHTML = `
        <div class="empty-state">
          <strong>Searching...</strong>
          Finding relevant local businesses.
        </div>
      `;

      try {

        const response =
          await fetch(AI_SEARCH_URL, {
            method: "POST",

            headers: {
              "Content-Type": "application/json",
              "apikey": SUPABASE_KEY
            },

            body: JSON.stringify({
              query: query,
              location: location
            })
          });


        let data = null;

        try {
          data = await response.json();
        } catch (jsonError) {
          data = null;
        }


        if (!response.ok) {

          const serverMessage =
            data &&
            (
              data.error ||
              data.message
            );

          throw new Error(
            serverMessage ||
            "AI search failed with HTTP " +
              response.status
          );
        }


        if (
          data &&
          data.answer
        ) {
          aiAnswerText.textContent =
            data.answer;

          aiAnswer.classList.add("show");
        }


        const businesses =
          Array.isArray(data?.results)
            ? data.results
            : Array.isArray(data?.businesses)
              ? data.businesses
              : [];


        renderResults(businesses);


        setSearchStatus(
          businesses.length > 0
            ? `Found ${businesses.length} matching business${businesses.length === 1 ? "" : "es"}.`
            : "Search completed, but no matching businesses were found.",
          businesses.length > 0
            ? "success"
            : ""
        );


        document
          .getElementById("results")
          .scrollIntoView({
            behavior: "smooth",
            block: "start"
          });

      } catch (error) {

        console.error(
          "JUST ASK AI search error:",
          error
        );

        resultsGrid.innerHTML = `
          <div class="empty-state">
            <strong>Search could not be completed</strong>
            Please try again in a moment.
          </div>
        `;

        setSearchStatus(
          error.message ||
            "Unable to connect to JUST ASK AI.",
          "error"
        );

      } finally {

        searchButton.disabled = false;
        searchButton.textContent = "Ask AI";

      }
    }


    searchForm.addEventListener(
      "submit",
      function(event) {

        event.preventDefault();

        const query =
          searchQuery.value.trim();

        const location =
          searchLocation.value.trim();

        if (!query) {
          setSearchStatus(
            "Please enter something to search for.",
            "error"
          );

          searchQuery.focus();

          return;
        }

        performAISearch(
          query,
          location
        );
      }
    );


    /*
      ============================================================
      DIRECTORY
      ============================================================
    */

    let directoryBusinesses = [];


    async function loadDirectory() {

      if (!hasSupabaseKey()) {

        directoryGrid.innerHTML = `
          <div class="empty-state">
            <strong>Supabase key required</strong>
            Add your publishable key to load the directory.
          </div>
        `;

        return;
      }


      directoryGrid.innerHTML = `
        <div class="empty-state">
          <strong>Loading directory...</strong>
          Please wait.
        </div>
      `;


      try {

        const url =
          BUSINESSES_URL +
          "?select=*&status=eq.approved&order=business_name.asc";


        const response =
          await fetch(url, {
            method: "GET",

            headers: {
              "apikey": SUPABASE_KEY,
              "Content-Type": "application/json"
            }
          });


        if (!response.ok) {

          let errorData = null;

          try {
            errorData =
              await response.json();
          } catch (error) {
            errorData = null;
          }

          throw new Error(
            errorData?.message ||
            errorData?.error ||
            "Directory request failed with HTTP " +
              response.status
          );
        }


        const data =
          await response.json();


        directoryBusinesses =
          Array.isArray(data)
            ? data
            : [];


        renderDirectory(
          directoryBusinesses
        );

      } catch (error) {

        console.error(
          "Directory error:",
          error
        );

        directoryGrid.innerHTML = `
          <div class="empty-state">
            <strong>Directory unavailable</strong>
            ${escapeHtml(
              error.message ||
              "Unable to load businesses."
            )}
          </div>
        `;
      }
    }


    function renderDirectory(items) {

      if (!Array.isArray(items) || items.length === 0) {

        directoryGrid.innerHTML = `
          <div class="empty-state">
            <strong>No approved businesses yet</strong>
            Businesses submitted to the directory will appear here after approval.
          </div>
        `;

        return;
      }


      directoryGrid.innerHTML =
        items
          .map(createBusinessCard)
          .join("");
    }


    directoryRefresh.addEventListener(
      "click",
      loadDirectory
    );


    directorySearch.addEventListener(
      "input",
      function() {

        const search =
          directorySearch.value
            .trim()
            .toLowerCase();


        if (!search) {
          renderDirectory(
            directoryBusinesses
          );

          return;
        }


        const filtered =
          directoryBusinesses.filter(
            function(business) {

              const searchable = [
                business.business_name,
                business.category,
                business.description,
                business.address,
                business.area,
                business.postcode
              ]
                .filter(Boolean)
                .join(" ")
                .toLowerCase();

              return searchable.includes(
                search
              );
            }
          );


        renderDirectory(filtered);
      }
    );


    /*
      ============================================================
      BUSINESS REGISTRATION
      ============================================================
    */

    businessForm.addEventListener(
      "submit",
      async function(event) {

        event.preventDefault();

        clearBusinessMessage();


        if (!hasSupabaseKey()) {

          setBusinessMessage(
            "Add your Supabase publishable key to index.html before submitting.",
            "error"
          );

          return;
        }


        businessSubmit.disabled = true;
        businessSubmit.textContent =
          "Submitting...";


        const formData =
          new FormData(
            businessForm
          );


        const business = {

          business_name:
            String(
              formData.get("business_name") || ""
            ).trim(),

          category:
            String(
              formData.get("category") || ""
            ).trim(),

          description:
            String(
              formData.get("description") || ""
            ).trim() || null,

          address:
            String(
              formData.get("address") || ""
            ).trim() || null,

          area:
            String(
              formData.get("area") || ""
            ).trim() || null,

          postcode:
            String(
              formData.get("postcode") || ""
            ).trim() || null,

          phone:
            String(
              formData.get("phone") || ""
            ).trim() || null,

          email:
            String(
              formData.get("email") || ""
            ).trim() || null,

          website:
            String(
              formData.get("website") || ""
            ).trim() || null,

          opening_hours:
            String(
              formData.get("opening_hours") || ""
            ).trim() || null,

          status: "pending"
        };


        if (
          !business.business_name ||
          !business.category
        ) {

          setBusinessMessage(
            "Business name and category are required.",
            "error"
          );

          businessSubmit.disabled = false;
          businessSubmit.textContent =
            "Submit Business";

          return;
        }


        try {

          const response =
            await fetch(
              BUSINESSES_URL,
              {
                method: "POST",

                headers: {
                  "apikey": SUPABASE_KEY,
                  "Content-Type": "application/json",
                  "Prefer": "return=minimal"
                },

                body: JSON.stringify(
                  business
                )
              }
            );


          if (!response.ok) {

            let errorData = null;

            try {
              errorData =
                await response.json();
            } catch (error) {
              errorData = null;
            }


            throw new Error(
              errorData?.message ||
              errorData?.error_description ||
              errorData?.hint ||
              errorData?.details ||
              "Business submission failed with HTTP " +
                response.status
            );
          }


          setBusinessMessage(
            "Thanks! Your business has been submitted and is awaiting approval.",
            "success"
          );


          businessForm.reset();


          await loadDirectory();

        } catch (error) {

          console.error(
            "Business submission error:",
            error
          );

          setBusinessMessage(
            error.message ||
              "Unable to submit your business.",
            "error"
          );

        } finally {

          businessSubmit.disabled = false;
          businessSubmit.textContent =
            "Submit Business";

        }
      }
    );


    /*
      ============================================================
      INITIALISE
      ============================================================
    */

    document.addEventListener(
      "DOMContentLoaded",
      function() {
        loadDirectory();
      }
    );

    /*
      The DOMContentLoaded listener above is safe even if this
      script executes after the document has already loaded because
      the script is located at the bottom of the body.
    */

    loadDirectory();

  </script>

